  const دخول = استدعاء_api_(رابط_احداثيات_المحطات, { action: 'loginByPhone', phone: '+966555555555' });
  if (!دخول.نجح || (دخول.بيانات && دخول.بيانات.error)) {
    return { اسم_المشروع: 'احداثيات المحطات', سليم: false, ملاحظة: 'فشل تسجيل الدخول: ' + وصف_الخطأ_(دخول) };
  }

  const بيانات = استدعاء_api_(رابط_احداثيات_المحطات, { action: 'getStats', phone: '+966555555555' });
  if (!بيانات.نجح || (بيانات.بيانات && بيانات.بيانات.error)) {
