/**
 * نقطة الدخول: تُشغَّل تلقائيًا كل 12 ساعة عبر مشغّل زمني (وتُشغَّل
 * يدويًا أول مرة من محرر Apps Script لاختبارها والموافقة على الأذونات).
 */
function تشغيل_الفحص_الدوري() {
  // حماية تزامن — احتياطًا من أي تعديل مستقبلي على المشغّلات الزمنية يُنشئ تداخلًا مع الفحص
  // العميق اليومي (تشغيل_الفحص_العميق_اليومي) غير متوقَّع حاليًا بالتوقيتات القائمة (12ص/12ظ
  // مقابل 3ف)، لكن القفل يمنعه بلا قيد على تلك التوقيتات تحديدًا
  const قفل = LockService.getScriptLock();
  if (!قفل.tryLock(30000)) { Logger.log('تعذّر الحصول على القفل — فحص آخر قيد التنفيذ بالفعل'); return; }
  const وقت_البدء = new Date();
  try {
    // كل فحص مستقل تمامًا (try/catch داخلي عبر استدعاء_api_) — فشل مشروع واحد لا يوقف فحص البقية
    // ولا يمنع إرسال التقرير. تُجمَع كل النتائج أولًا، ثم تُحدَّث الحالات، ثم يُرسل التقرير أخيرًا —
    // وليس فحص←تحديث←فحص←تحديث متداخلًا (مهم لسهولة بناء Level 5 لاحقًا فوق هذا الترتيب بلا تغيير)
    const نتائج = [
      فحص_سهم_(),
      فحص_تصاريح_العمل_(),
      فحص_عائلة_السلامي_(),
      فحص_احداثيات_المحطات_()
    ];

    نتائج.forEach(function (نتيجة) {
      // الحالة والنسبة النهائيتان الحقيقيتان (قد تكون "تحذير" ونسبة أقل من
      // 100% حتى لو الفحص الفني نجح، لو كانت هناك حالات مفتوحة مسجَّلة) —
      // نفس القيم المكتوبة بالجدول بالضبط، لضمان تطابق تام مع الإيميل.
      const نتيجة_التحديث = تحديث_حالة_المشروع_(نتيجة.اسم_المشروع, نتيجة.سليم);
      نتيجة.الحالة_النهائية = نتيجة_التحديث ? نتيجة_التحديث.حالة : null;
      نتيجة.النسبة_النهائية = نتيجة_التحديث ? نتيجة_التحديث.نسبة : null;
    });

    // Level 5 — يُقرأ التاريخ *قبل* تسجيل بيانات هذا التشغيل (وإلا يُقارَن التشغيل بنفسه)، ثم
    // تُدمَج ملاحظات هذا التشغيل مع أي ملاحظات فحص عميق معلَّقة لم تُعرَض بعد بأي تقرير دوري سابق
    const سجل_سابق = قراءة_سجل_فحوص_مجمَّع_();
    const ملاحظات_هذا_التشغيل = تحليل_الاتجاهات_(نتائج, 'دوري', سجل_سابق);
    const ملاحظات_عميقة_معلّقة = سحب_الملاحظات_العميقة_المعلّقة_();
    const كل_الملاحظات = ملاحظات_عميقة_معلّقة.concat(ملاحظات_هذا_التشغيل);

    إرسال_تقرير_الفحص_(نتائج, كل_الملاحظات);
    تسجيل_تاريخ_التشغيل_('دوري', وقت_البدء, new Date(), نتائج, true);
  } finally {
    قفل.releaseLock();
  }
}

/**
 * يستدعي واجهة برمجة تطبيقات (API) عبر POST ويُرجع الاستجابة كـJSON.
 * لا يُطلق استثناءً أبدًا — أي خطأ (اتصال/مهلة/JSON غير صالح) يُرجَع
 * كنتيجة فاشلة عادية، حتى لا يتوقف فحص بقية المشاريع بسبب خطأ بواحد.
 *
 * يعيد المحاولة تلقائيًا مرة واحدة (بعد تأخير قصير) لو فشلت المحاولة
 * الأولى — الاتصال بين خوادم قوقل عبر إعادة توجيه قد يفشل أحيانًا بشكل
 * عابر لمرة واحدة فقط، ولا يجب أن يُبلَّغ مشروع سليم فعليًا كـ"متوقف"
 * بسبب عثرة شبكة عابرة كهذه.
 *
 * زمن_ms يُقاس دائمًا لكل محاولة فعلية (نجحت أو فشلت) — أساس القياس لكل نتائج الفحص المُهيكَلة
 * (فحوصات[])، ومباشرة يخدم Level 5 (الذكاء التاريخي). رمز_HTTP (getResponseCode()) يُلتقَط أيضًا
 * دائمًا عند وصول استجابة فعلية — يُستخدَم لاحقًا في CheckEngine.gs لاشتقاق "رمز الخطأ" (فئة الخطأ:
 * AUTH_ERROR/RATE_LIMITED/SERVER_ERROR/...) بدل التخمين من نص الرسالة العربي الحر فقط.
 *
 * @param {string} الرابط
 * @param {Object} الحمولة
 * @param {Object} [ترويسات_إضافية]
 * @return {{نجح:boolean, بيانات?:Object, خطأ?:string, زمن_ms:number, رمز_HTTP?:number}}
 */
function استدعاء_api_(الرابط, الحمولة, ترويسات_إضافية) {
  for (let محاولة = 1; محاولة <= 2; محاولة++) {
    const بداية_القياس = Date.now();
    try {
      const خيارات = {
        method: 'post',
        contentType: 'application/json',
        payload: JSON.stringify(الحمولة),
        muteHttpExceptions: true,
        followRedirects: true
      };
      if (ترويسات_إضافية) خيارات.headers = ترويسات_إضافية;

      const استجابة = UrlFetchApp.fetch(الرابط, خيارات);
      const زمن_ms = Date.now() - بداية_القياس;
      const رمز_HTTP = استجابة.getResponseCode();
      const بيانات = JSON.parse(استجابة.getContentText());
      // "إجراء غير معروف" هو عرَض معروف لفقدان جسم الطلب أثناء إعادة توجيه
      // عابرة بين خوادم قوقل — يستحق إعادة محاولة قبل اعتباره فشلاً حقيقيًا.
      // فحص عام (يحتوي النص) وليس تطابقًا دقيقًا، لأن كل مشروع يصيغ هذه
      // الرسالة بصيغة مختلفة قليلاً (بعضها يُلحق اسم الإجراء وبعضها لا)
      if (بيانات && typeof بيانات.error === 'string' && بيانات.error.indexOf('إجراء غير معروف') !== -1 && محاولة === 1) {
        Utilities.sleep(1500);
        continue;
      }
      return { نجح: true, بيانات: بيانات, زمن_ms: زمن_ms, رمز_HTTP: رمز_HTTP };
    } catch (خطأ) {
      const زمن_ms = Date.now() - بداية_القياس;
      if (محاولة === 1) { Utilities.sleep(1500); continue; }
      return { نجح: false, خطأ: خطأ.toString(), زمن_ms: زمن_ms };
    }
  }
}

/**
 * Level 3 (DB/Activity): طلب GET مباشر لـPostgREST (وليس POST بجسم JSON كـ"استدعاء_api_" المخصَّصة
 * لعقد Edge Functions/Apps Script) — يختبر استجابة Postgres نفسه مباشرة، بلا المرور بأي كود
 * Edge Function وسيط. يقيس زمن_ms بنفس نمط استدعاء_api_ بالضبط (قبل/بعد الطلب، حتى عند الفشل).
 * نجاح PostgREST الحقيقي = استجابة تُرجع مصفوفة صفوف مباشرة (وليس {success:...} كعقد Edge Functions).
 * @param {string} مسار مثال: "الإعدادات العامة?select=المفتاح&limit=1" (يُبنى بترميز URL صحيح من المستدعي)
 * @return {{نجح:boolean, بيانات?:*, خطأ?:string, زمن_ms:number}}
 */
function استدعاء_postgrest_(مسار) {
  const بداية_القياس = Date.now();
  try {
    const استجابة = UrlFetchApp.fetch(رابط_عائلة_السلامي_postgrest + مسار, {
      method: 'get',
      headers: { apikey: مفتاح_عائلة_السلامي_العام, Authorization: 'Bearer ' + مفتاح_عائلة_السلامي_العام },
      muteHttpExceptions: true
    });
    const زمن_ms = Date.now() - بداية_القياس;
    const رمز_HTTP = استجابة.getResponseCode();
    const بيانات = JSON.parse(استجابة.getContentText());
    return { نجح: true, بيانات: بيانات, زمن_ms: زمن_ms, رمز_HTTP: رمز_HTTP };
  } catch (خطأ) {
    return { نجح: false, خطأ: خطأ.toString(), زمن_ms: Date.now() - بداية_القياس };
  }
}

/**
 * يستدعي Supabase Management API عبر GET فقط لنقطة نهاية محصورة بـWhitelist داخلي — لا تقبل أي
 * URL/مسار خارجي إطلاقًا، فقط مفتاحًا منطقيًا ('HEALTH'|'USAGE'). مختلفة كليًا عن استدعاء_api_
 * (POST لعقود Edge Functions) واستدعاء_postgrest_ (anon key). التوكن قد يكون Scoped أو Classic حسب
 * ما هو متاح بحساب Supabase — في كل الأحوال، هذه الدالة نفسها لا تسمح إلا بنقطتي HEALTH وUSAGE عبر
 * GET فقط: method='get' حرفيًا بلا معامل يُغيّره، رفض فوري بلا أي طلب شبكة لو المفتاح غير معروف،
 * ورسالة الفشل ثابتة عامة عمدًا (لا تُدرِج نص الاستثناء الخام) حتى لا يتسرب أي تفصيل حساس عبر رسالة
 * خطأ تصل التقرير/البريد.
 *
 * "نجح" يعكس حصرًا نجاح HTTP نفسه (2xx) — وليس مجرد نجاح تحليل JSON. استجابة 401/403/429/500+
 * تُعامَل كفشل صريح رغم احتمال كون جسمها JSON صالحًا تمامًا (رسالة خطأ منسَّقة من Supabase)، حتى
 * تتوافق FAMILY.HEALTH/FAMILY.USAGE تمامًا مع منطق اشتقاق_رمز_الخطأ_ أدناه بدل أن تُبلَّغ زورًا
 * كـPASS لمجرد أن الجسم قابل للتحليل. رمز_HTTP يبقى محفوظًا دائمًا حتى لو فشل تحليل الجسم كـJSON.
 * @param {string} مفتاح_نقطة_النهاية 'HEALTH' أو 'USAGE' فقط
 * @return {{نجح:boolean, بيانات?:*, خطأ?:string, زمن_ms:number, رمز_HTTP?:number}}
 */
function استدعاء_supabase_management_api_(مفتاح_نقطة_النهاية) {
  const بداية_القياس = Date.now();
  const نقطة = قائمة_نقاط_supabase_management_api_المسموحة_[مفتاح_نقطة_النهاية];
  if (!نقطة) return { نجح: false, خطأ: 'نقطة نهاية غير معروفة', زمن_ms: 0 };

  const التوكن = PropertiesService.getScriptProperties().getProperty('توكن_supabase_management_عائلة_السلامي');
  if (!التوكن) return { نجح: false, خطأ: 'توكن Management API غير مخزَّن بعد', زمن_ms: 0 };

  const الرابط = قاعدة_رابط_supabase_management_api_ + رمز_مشروع_عائلة_السلامي_management_ + '/' +
    نقطة.المسار + (نقطة.الاستعلام ? '?' + نقطة.الاستعلام : '');

  let استجابة;
  try {
    استجابة = UrlFetchApp.fetch(الرابط, {
      method: 'get', // GET صريح حرفيًا — لا معامل بالكائن يسمح بتغييره
      headers: { Authorization: 'Bearer ' + التوكن },
      muteHttpExceptions: true
    });
  } catch (خطأ) {
    // استثناء شبكة/DNS/مهلة حقيقي — لا استجابة وصلت إطلاقًا، فلا يوجد رمز_HTTP لنحافظ عليه هنا
    return { نجح: false, خطأ: 'تعذّر الاتصال بـSupabase Management API', زمن_ms: Date.now() - بداية_القياس };
  }

  // من هنا فصاعدًا وصلت استجابة فعلية دائمًا — رمز_HTTP يُحفَظ دائمًا بغض النظر عن نجاح JSON.parse،
  // حتى لا يُفقَد رمز حقيقي (مثال: 500 بجسم HTML لا JSON) داخل catch عام يُسقطه لصالح NETWORK_ERROR
  const زمن_ms = Date.now() - بداية_القياس;
  const رمز_HTTP = استجابة.getResponseCode();
  const نجح_HTTP = رمز_HTTP >= 200 && رمز_HTTP < 300; // 2xx فقط = نجاح — وليس مجرد نجاح JSON.parse
  let بيانات;
  try { بيانات = JSON.parse(استجابة.getContentText()); } catch (خطأ_تحليل) { بيانات = undefined; }
  return { نجح: نجح_HTTP, بيانات: بيانات, زمن_ms: زمن_ms, رمز_HTTP: رمز_HTTP };
}

/**
 * يشتق فئة خطأ خام (Error Code) من رمز HTTP الفعلي — وليس تخمينًا من نص رسالة عربي حر (لا يوجد لدى
 * أي من المشاريع الأربعة رمز خطأ مُهيكَل حقيقي بعد). فئة تقريبية لكنها صادقة بما هو متاح فعليًا:
 * لا استجابة إطلاقًا (استثناء شبكة/DNS/مهلة) = NETWORK_ERROR؛ 401/403 = AUTH_ERROR؛ 429 = RATE_LIMITED؛
 * 5xx = SERVER_ERROR؛ 2xx لكن فشل منطقي بالتطبيق نفسه = APP_ERROR؛ غير ذلك = UNKNOWN_ERROR.
 * @return {string} فارغة إن لم يفشل الفحص أصلًا
 */
function اشتقاق_رمز_الخطأ_(نتيجة_استدعاء, فشل) {
  if (!فشل) return '';
  if (!نتيجة_استدعاء.نجح) return 'NETWORK_ERROR';
  const رمز = نتيجة_استدعاء.رمز_HTTP;
  if (رمز === 401 || رمز === 403) return 'AUTH_ERROR';
  if (رمز === 429) return 'RATE_LIMITED';
  if (رمز >= 500) return 'SERVER_ERROR';
  if (رمز >= 200 && رمز < 300) return 'APP_ERROR';
  return 'UNKNOWN_ERROR';
}

/**
 * يبني سجل فحص فرعي واحد مُهيكَل من نتيجة استدعاء_api_. "فشل" يُمرَّر صريحًا من المستدعي (وليس
 * محسوبًا هنا تلقائيًا) لأن لكل مشروع عقد استجابة مختلفًا تمامًا: سهم/احداثيات المحطات {error}،
 * تصاريح العمل {ok}، عائلة السلامي (Supabase) {success} — تخمين موحَّد هنا كان سيُخطئ لبعضها.
 *
 * "معرف" هوية منطقية ثابتة للفحص (مثال: 'SAHM.LOGIN') لا تتغيّر أبدًا حتى لو تغيّر "اسم" العرض
 * لاحقًا — أساس مطابقة Level 5 التاريخية عبر التشغيلات (مفتاح المقارنة: مشروع+معرف+نوع التشغيل).
 *
 * @param {string} معرف هوية ثابتة (مثال: 'SAHM.LOGIN') — لا تُعرَض بالإيميل، فقط للسجل التاريخي
 * @param {string} اسم اسم الفحص المعروض (مثال: 'loginByPhone')
 * @param {boolean} أساسي Core=true أم Secondary=false
 * @param {{نجح:boolean, بيانات?:Object, خطأ?:string, زمن_ms:number, رمز_HTTP?:number}} نتيجة_استدعاء
 * @param {boolean} فشل
 * @param {Object} [بيانات_إضافية] اختياري — بيانات خام إضافية تُخزَّن بالسجل التاريخي فقط (مثال:
 *   عدادات Usage من Level 4)، بلا أي حكم عليها الآن. يُهمَل كليًا إن غاب — كل الاستدعاءات الحالية
 *   عبر المشاريع الأربعة تبقى بلا أي تغيير سلوكي.
 * @return {{معرف:string, اسم:string, أساسي:boolean, الحالة:string, زمن_ms:number, رمز_HTTP:(number|string), رمز_الخطأ:string, رسالة_خطأ:string, بيانات_إضافية:(Object|null)}}
 */
function بناء_نتيجة_فحص_(معرف, اسم, أساسي, نتيجة_استدعاء, فشل, بيانات_إضافية) {
  // اختبار فشل قسري مستهدَف لهذا الفحص تحديدًا بمعرفه الثابت — يتجاوز النتيجة الحقيقية تمامًا (بلا
  // لمس فحوصات أخرى بنفس المشروع)، حتى يختبر محرّك التصعيد PASS←FAIL←FAIL←PASS على هوية فحص حقيقية
  // فعلية لها تاريخ سابق، بدل معرف اصطناعي منفصل لا يملك أي سجل يُقارَن به (انظر تعليق الدالة أعلاه)
  if (فحص_مُستهدَف_للفشل_القسري_(معرف)) {
    return {
      معرف: معرف, اسم: اسم, أساسي: أساسي, الحالة: 'FAIL',
      زمن_ms: نتيجة_استدعاء.زمن_ms || 0, رمز_HTTP: '', رمز_الخطأ: 'TEST_FAILURE',
      رسالة_خطأ: 'فشل اختباري قسري (اختبار_فشل_قسري)', بيانات_إضافية: null
    };
  }
  return {
    معرف: معرف,
    اسم: اسم,
    أساسي: أساسي,
    الحالة: فشل ? 'FAIL' : 'PASS',
    زمن_ms: نتيجة_استدعاء.زمن_ms || 0,
    رمز_HTTP: نتيجة_استدعاء.رمز_HTTP || '',
    رمز_الخطأ: اشتقاق_رمز_الخطأ_(نتيجة_استدعاء, فشل),
    رسالة_خطأ: فشل ? وصف_الخطأ_(نتيجة_استدعاء) : '',
    بيانات_إضافية: بيانات_إضافية || null
  };
}

/**
 * يحوّل مصفوفة فحوصات مُهيكَلة إلى نتيجة نهائية بنفس شكل نتيجة الفحص القديم تمامًا (توافق كامل
 * مع تحديث_حالة_المشروع_/إرسال_تقرير_الفحص_ الحاليتين، بلا أي تعديل عليهما) + مصفوفة فحوصات[]
 * الخام كاملة لاستخدام Level 5 لاحقًا بلا إعادة هيكلة.
 *
 * فشل فحص أساسي (Core) واحد على الأقل → سليم=false ("متوقف" لاحقًا).
 * فشل فحص ثانوي (Secondary) فقط، مع نجاح كل الأساسية → سليم يبقى true، لكن الملاحظة تذكر الفشل
 * الجزئي صراحةً بدل إخفائه — تمييز حقيقي بين "توقف" و"يعمل جزئيًا"، أساس محرّك التصعيد بـLevel 5.
 * @param {string} اسم_المشروع
 * @param {Array} فحوصات
 * @return {{اسم_المشروع:string, سليم:boolean, ملاحظة:string, فحوصات:Array}}
 */
function تلخيص_نتائج_الفحص_(اسم_المشروع, فحوصات) {
  const أساسية_فاشلة = فحوصات.filter(function (ف) { return ف.أساسي && ف.الحالة === 'FAIL'; });
  const ثانوية_فاشلة = فحوصات.filter(function (ف) { return !ف.أساسي && ف.الحالة === 'FAIL'; });

  if (أساسية_فاشلة.length > 0) {
    return {
      اسم_المشروع: اسم_المشروع,
      سليم: false,
      ملاحظة: 'فشل فحص أساسي (' + أساسية_فاشلة[0].اسم + '): ' + أساسية_فاشلة[0].رسالة_خطأ,
      فحوصات: فحوصات
    };
  }
  if (ثانوية_فاشلة.length > 0) {
    return {
      اسم_المشروع: اسم_المشروع,
      سليم: true,
      ملاحظة: 'الأساسي يعمل بنجاح، لكن ' + ثانوية_فاشلة.map(function (ف) { return ف.اسم; }).join('، ') +
        ' (ثانوي) فشل: ' + ثانوية_فاشلة[0].رسالة_خطأ,
      فحوصات: فحوصات
    };
  }
  return {
    اسم_المشروع: اسم_المشروع,
    سليم: true,
    ملاحظة: 'كل الفحوصات (' + فحوصات.map(function (ف) { return ف.اسم; }).join('، ') + ') تعمل بنجاح',
    فحوصات: فحوصات
  };
}

/**
 * اختبار فشل محكوم بلا أي لمس لبيانات/توكنات حقيقية — يستهدف **فحصًا واحدًا محدَّدًا بمعرفه الثابت**
 * (مثال: 'STATIONS.PING')، وليس مشروعًا كاملاً: Script Property "اختبار_فشل_قسري" تحمل معرف الفحص
 * المستهدَف مباشرة. هذا (وليس تعطيل المشروع بالكامل) هو ما يسمح فعليًا باختبار انتقالات محرّك
 * التصعيد الحقيقية (FAIL مرتين متتاليتين ← 🔴، ثم PASS ← 🟡 تعافٍ) على **نفس هوية الفحص** التي
 * سيقارن بها التاريخ لاحقًا — فحص اصطناعي بمعرف مختلف (كما كانت النسخة الأولى) لا يملك أي تاريخ
 * PASS سابق ليُقارَن به، فلا يمكنه إظهار "تعافى" أبدًا مهما فعلت. بقية فحوصات نفس المشروع (وكل
 * المشاريع الأخرى) تعمل طبيعيًا وبلا أي تأثير. يجب مسح هذا الـProperty فور انتهاء الاختبار.
 * @param {string} معرف_الفحص المعرف الثابت لهذا الفحص تحديدًا (نفس القيمة المُمرَّرة لـبناء_نتيجة_فحص_)
 * @return {boolean}
 */
function فحص_مُستهدَف_للفشل_القسري_(معرف_الفحص) {
  const المستهدَف = PropertiesService.getScriptProperties().getProperty('اختبار_فشل_قسري');
  return !!المستهدَف && المستهدَف === معرف_الفحص;
}

/** فحص "سهم": تسجيل دخول (Core) + getOverviewBundle (Core) — يغطي معظم مسار القراءة أصلًا، فلا
 * إضافة أخرى فوقه (قرار صريح: إضافة نقاط أخرى هنا تكرار بلا فائدة حقيقية) */
function فحص_سهم_() {
  const اسم = 'سهم';

  const دخول = استدعاء_api_(رابط_سهم, { action: 'loginByPhone', phone: '+966555555555' });
  const فشل_دخول = !دخول.نجح || (دخول.بيانات && دخول.بيانات.error);
  const فحص_دخول = بناء_نتيجة_فحص_('SAHM.LOGIN', 'loginByPhone', true, دخول, فشل_دخول);
  if (فشل_دخول) return تلخيص_نتائج_الفحص_(اسم, [فحص_دخول]);

  // getOverviewBundle تتطلب عضوًا نشطًا مسجَّل دخول (تحصين أمني بمشروع سهم) — يجب تمرير
  // identityToken الصادر من تسجيل الدخول أعلاه، وإلا تُرفَض بـ"يجب تسجيل الدخول لعرض هذه البيانات"
  const رمز_الهوية = دخول.بيانات.identityToken;
  const بيانات = استدعاء_api_(رابط_سهم, { action: 'getOverviewBundle', identityToken: رمز_الهوية });
  const فشل_بيانات = !بيانات.نجح || (بيانات.بيانات && بيانات.بيانات.error);
  const فحص_بيانات = بناء_نتيجة_فحص_('SAHM.OVERVIEW', 'getOverviewBundle', true, بيانات, فشل_بيانات);

  return تلخيص_نتائج_الفحص_(اسم, [فحص_دخول, فحص_بيانات]);
}

/** فحص "تصاريح العمل": login+getMyProfile (Core)، listMyOperations (Secondary — فشله لا يعني توقف) */
function فحص_تصاريح_العمل_() {
  const اسم = 'تصاريح العمل - PTW - SFT';

  const دخول = استدعاء_api_(رابط_تصاريح_العمل, { action: 'login', data: { employeeId: '1' } });
  const فشل_دخول = !دخول.نجح || !دخول.بيانات || !دخول.بيانات.ok;
  if (فشل_دخول) {
    const رسالة = وصف_الخطأ_(دخول);
    const لم_يُضف_الحساب_بعد = /غير مسجَّل|غير مسجل/.test(رسالة);
    if (لم_يُضف_الحساب_بعد) {
      return { اسم_المشروع: اسم, سليم: null, ملاحظة: 'الفحص معطّل مؤقتًا — بانتظار إضافة حساب الفحص التلقائي يدويًا (رقم وظيفي 1)', فحوصات: [] };
    }
    return تلخيص_نتائج_الفحص_(اسم, [بناء_نتيجة_فحص_('PTW.LOGIN', 'login', true, دخول, true)]);
  }
  const فحص_دخول = بناء_نتيجة_فحص_('PTW.LOGIN', 'login', true, دخول, false);

  const توكن = دخول.بيانات.result.token;
  const بروفايل = استدعاء_api_(رابط_تصاريح_العمل, { action: 'getMyProfile', token: توكن, data: {} });
  const فشل_بروفايل = !بروفايل.نجح || !بروفايل.بيانات || !بروفايل.بيانات.ok;
  const فحص_بروفايل = بناء_نتيجة_فحص_('PTW.PROFILE', 'getMyProfile', true, بروفايل, فشل_بروفايل);
  if (فشل_بروفايل) return تلخيص_نتائج_الفحص_(اسم, [فحص_دخول, فحص_بروفايل]);

  // Secondary — إجراء حقيقي بالمشروع (auth:true admin:false)؛ فشله يُسجَّل بالملاحظة فقط، لا يُحوِّل الحالة لـ"متوقف"
  const عمليات = استدعاء_api_(رابط_تصاريح_العمل, { action: 'listMyOperations', token: توكن, data: {} });
  const فشل_عمليات = !عمليات.نجح || !عمليات.بيانات || !عمليات.بيانات.ok;
  const فحص_عمليات = بناء_نتيجة_فحص_('PTW.OPERATIONS', 'listMyOperations', false, عمليات, فشل_عمليات);

  return تلخيص_نتائج_الفحص_(اسم, [فحص_دخول, فحص_بروفايل, فحص_عمليات]);
}

/**
 * فحص "عائلة السلامي": تسجيل دخول (Core) بحساب "فحص تلقائي" (مؤرشف بالشجرة) عبر Supabase Edge
 * Function مباشرة (مشروع مختلف تقنيًا عن باقي المشاريع — لا يمر عبر Google Apps Script)، ثم
 * getFunds من manage-funds (Secondary — قراءة عامة حقيقية بلا تسجيل دخول حتى، اختيرت بعد فحص كود
 * manage-tree/manage-funds فعليًا: أقل حمولة وأخف صلاحيات من manage-tree/getFamilyTree)، ثم نبضة
 * قاعدة بيانات خام عبر PostgREST (Secondary — Level 3: تتجاوز Edge Function كليًا، تفصل حقًا "الدالة
 * معطوبة" عن "Postgres نفسه لا يستجيب" — عرض عام "الإعدادات العامة"، مُصرَّح anon صراحةً بكود RLS).
 * كلمة المرور تُقرأ من Script Properties الخاص بهذا المشروع فقط. لو لم تكن مخزَّنة بعد، الفحص معطّل بأمان.
 */
function فحص_عائلة_السلامي_() {
  const اسم = 'عائلة السلامي فخذ العافاريت';

  const كلمة_المرور = PropertiesService.getScriptProperties().getProperty('كلمة_مرور_فحص_عائلة_السلامي');
  if (!كلمة_المرور) {
    return { اسم_المشروع: اسم, سليم: null, ملاحظة: 'الفحص معطّل مؤقتًا — بانتظار تخزين كلمة مرور حساب الفحص التلقائي', فحوصات: [] };
  }

  const دخول = استدعاء_api_(رابط_عائلة_السلامي, { nationalId: '1111111111', password: كلمة_المرور }, {
    apikey: مفتاح_عائلة_السلامي_العام,
    Authorization: 'Bearer ' + مفتاح_عائلة_السلامي_العام
  });
  const فشل_دخول = !دخول.نجح || !دخول.بيانات || !دخول.بيانات.success;
  const فحص_دخول = بناء_نتيجة_فحص_('FAMILY.LOGIN', 'login', true, دخول, فشل_دخول);
  if (فشل_دخول) return تلخيص_نتائج_الفحص_(اسم, [فحص_دخول]);

  const صناديق = استدعاء_api_(رابط_عائلة_السلامي_الصناديق, { action: 'getFunds' }, {
    apikey: مفتاح_عائلة_السلامي_العام,
    Authorization: 'Bearer ' + مفتاح_عائلة_السلامي_العام
  });
  const فشل_صناديق = !صناديق.نجح || !صناديق.بيانات || !صناديق.بيانات.success;
  const فحص_صناديق = بناء_نتيجة_فحص_('FAMILY.FUNDS', 'getFunds', false, صناديق, فشل_صناديق);

  // Level 3 — نبضة قاعدة بيانات خام (PostgREST مباشر، بلا Edge Function وسيط)
  const مسار_الإعدادات_العامة = encodeURIComponent('الإعدادات العامة') + '?select=' + encodeURIComponent('المفتاح') + '&limit=1';
  const قاعدة_البيانات = استدعاء_postgrest_(مسار_الإعدادات_العامة);
  const فشل_قاعدة_البيانات = !قاعدة_البيانات.نجح || !Array.isArray(قاعدة_البيانات.بيانات);
  const فحص_قاعدة_البيانات = بناء_نتيجة_فحص_('FAMILY.POSTGREST', 'postgrest_مباشر', false, قاعدة_البيانات, فشل_قاعدة_البيانات);

  return تلخيص_نتائج_الفحص_(اسم, [فحص_دخول, فحص_صناديق, فحص_قاعدة_البيانات]);
}

/**
 * فحص عميق يومي لعائلة السلامي (Level 4 Phase 1 — Supabase Management API): LOGIN (Core، إلزامي
 * هنا رغم أن HEALTH/USAGE لا يحتاجانه فعليًا، لأن تلخيص_نتائج_الفحص_ تُرجع سليم=true تلقائيًا لو
 * غاب أي فحص Core من المصفوفة — بلا LOGIN هنا سيكون "سليم" بلا معنى حقيقي) + HEALTH (Secondary،
 * صحة خدمات المشروع) + USAGE (Secondary، عدادات استخدام API، تُخزَّن خامًا فقط بلا أي حكم على
 * القيم — الحكم على الأنماط التاريخية عمل Level 4 Phase 2 لاحقًا). لا يُحدَّث صف "الرئيسية" من
 * نتيجة هذا الفحص (قرار محمد الصريح: هذا Resource Monitoring وليس Availability check) — فقط
 * تسجيل تاريخي + تحليل اتجاهات، بنفس صمت الفحص العميق الحالي لاحداثيات المحطات من ناحية البريد.
 */
function فحص_عائلة_السلامي_العميق_() {
  const اسم = 'عائلة السلامي فخذ العافاريت';

  const كلمة_المرور = PropertiesService.getScriptProperties().getProperty('كلمة_مرور_فحص_عائلة_السلامي');
  if (!كلمة_المرور) {
    return { اسم_المشروع: اسم, سليم: null, ملاحظة: 'الفحص العميق معطّل مؤقتًا — بانتظار تخزين كلمة مرور حساب الفحص التلقائي', فحوصات: [] };
  }

  const دخول = استدعاء_api_(رابط_عائلة_السلامي, { nationalId: '1111111111', password: كلمة_المرور }, {
    apikey: مفتاح_عائلة_السلامي_العام,
    Authorization: 'Bearer ' + مفتاح_عائلة_السلامي_العام
  });
  const فشل_دخول = !دخول.نجح || !دخول.بيانات || !دخول.بيانات.success;
  const فحص_دخول = بناء_نتيجة_فحص_('FAMILY.LOGIN', 'login', true, دخول, فشل_دخول);
  if (فشل_دخول) return تلخيص_نتائج_الفحص_(اسم, [فحص_دخول]);

  const صحة = استدعاء_supabase_management_api_('HEALTH');
  // شكل الاستجابة مؤكَّد بتشغيل فعلي (2026-09-04، وليس تخمينًا): مصفوفة عناصر
  // {name, healthy, status} — مثال حقيقي: [{"name":"db","healthy":true,"status":"ACTIVE_HEALTHY"}].
  // الفشل = فشل الطلب نفسه (غير 2xx)، أو شكل غير متوقَّع، أو أي خدمة ضمن القائمة healthy:false.
  const فشل_صحة = !صحة.نجح || !Array.isArray(صحة.بيانات) || صحة.بيانات.some(function (خ) { return خ.healthy === false; });
  const فحص_صحة = بناء_نتيجة_فحص_('FAMILY.HEALTH', 'management_health', false, صحة, فشل_صحة);

  const استخدام = استدعاء_supabase_management_api_('USAGE');
  // الشكل الفعلي الموثَّق: {result:[{timestamp, total_auth_requests, ...}], error} — وليس حقولاً مسطّحة
  const صف_الاستخدام = استخدام.نجح && استخدام.بيانات && Array.isArray(استخدام.بيانات.result) ? استخدام.بيانات.result[0] : null;
  const فشل_استخدام = !استخدام.نجح || !صف_الاستخدام;
  const بيانات_إضافية = صف_الاستخدام ? {
    timestamp: صف_الاستخدام.timestamp,
    total_auth_requests: صف_الاستخدام.total_auth_requests,
    total_realtime_requests: صف_الاستخدام.total_realtime_requests,
    total_rest_requests: صف_الاستخدام.total_rest_requests,
    total_storage_requests: صف_الاستخدام.total_storage_requests
  } : undefined;
  const فحص_استخدام = بناء_نتيجة_فحص_('FAMILY.USAGE', 'usage_api_counts', false, استخدام, فشل_استخدام, بيانات_إضافية);

  return تلخيص_نتائج_الفحص_(اسم, [فحص_دخول, فحص_صحة, فحص_استخدام]);
}

/** فحص "احداثيات المحطات" الدوري (كل 12 ساعة): تسجيل دخول (Core) + نبضة ping خفيفة (Core) —
 * إجراء ping موجود بالكود فعليًا ولم يكن مُستخدَمًا؛ getStats الأثقل انتقل لفحص عميق يومي منفصل
 * (فحص_احداثيات_المحطات_العميق_) بدل استدعائه كل 12 ساعة. الدخول بالبصمة يبقى غير قابل للفحص
 * الآلي (يحتاج جهازًا فعليًا) — يُفحَص مسار الجوال البديل فقط. */
function فحص_احداثيات_المحطات_() {
  const اسم = 'احداثيات المحطات';

  const دخول = استدعاء_api_(رابط_احداثيات_المحطات, { action: 'loginByPhone', phone: '+966555555555' });
  const فشل_دخول = !دخول.نجح || (دخول.بيانات && دخول.بيانات.error);
  const فحص_دخول = بناء_نتيجة_فحص_('STATIONS.LOGIN', 'loginByPhone', true, دخول, فشل_دخول);
  if (فشل_دخول) return تلخيص_نتائج_الفحص_(اسم, [فحص_دخول]);

  const نبضة = استدعاء_api_(رابط_احداثيات_المحطات, { action: 'ping' });
  const فشل_نبضة = !نبضة.نجح || !نبضة.بيانات || !نبضة.بيانات.success;
  const فحص_نبضة = بناء_نتيجة_فحص_('STATIONS.PING', 'ping', true, نبضة, فشل_نبضة);

  return تلخيص_نتائج_الفحص_(اسم, [فحص_دخول, فحص_نبضة]);
}

/** فحص عميق يومي منفصل (تشغيل_الفحص_العميق_اليومي أدناه): يختبر getStats الفعلي (أثقل من ping) —
 * منفصل عمدًا عن الفحص الدوري كل 12 ساعة تفاديًا لاستدعاء ثقيل متكرر بلا داعٍ */
function فحص_احداثيات_المحطات_العميق_() {
  const اسم = 'احداثيات المحطات';
  const دخول = استدعاء_api_(رابط_احداثيات_المحطات, { action: 'loginByPhone', phone: '+966555555555' });
  const فشل_دخول = !دخول.نجح || (دخول.بيانات && دخول.بيانات.error);
  const فحص_دخول = بناء_نتيجة_فحص_('STATIONS.LOGIN', 'loginByPhone', true, دخول, فشل_دخول);
  if (فشل_دخول) return تلخيص_نتائج_الفحص_(اسم, [فحص_دخول]);

  const بيانات = استدعاء_api_(رابط_احداثيات_المحطات, { action: 'getStats', phone: '+966555555555' });
  const فشل_بيانات = !بيانات.نجح || (بيانات.بيانات && بيانات.بيانات.error);
  const فحص_بيانات = بناء_نتيجة_فحص_('STATIONS.GET_STATS', 'getStats', true, بيانات, فشل_بيانات);

  return تلخيص_نتائج_الفحص_(اسم, [فحص_دخول, فحص_بيانات]);
}

/**
 * نقطة دخول الفحص العميق اليومي — Trigger منفصل تمامًا عن تشغيل_الفحص_الدوري (مثال: 3 فجرًا).
 * يفحص احداثيات المحطات (getStats) وعائلة السلامي (Level 4 Phase 1 — Supabase Management API).
 * محمي بنفس LockService لمنع أي تداخل تنفيذ مع الفحص الدوري (لا تعارض متوقَّع بالتوقيتات الحالية،
 * لكن القفل احتياط ضد أي تعديل مستقبلي على المشغّلات).
 * قرار مؤقت صريح لاحداثيات المحطات: يستدعي تحديث_حالة_المشروع_ نفسها بلا تعديل — الصف يعكس آخر
 * فحص وقع أيًا كان نوعه (دوري أو عميق). عند بناء Level 5، يجب فصل آخر Health/Deep/نجاح/فشل كحقول
 * مستقلة. **بخلاف ذلك تمامًا لعائلة السلامي**: قرار محمد الصريح أن لا يُحدَّث صف "الرئيسية" من هذا
 * الفحص إطلاقًا (هذا Resource Monitoring وليس Availability check) — يُسجَّل بالتاريخ فقط.
 */
function تشغيل_الفحص_العميق_اليومي() {
  const قفل = LockService.getScriptLock();
  if (!قفل.tryLock(30000)) { Logger.log('تعذّر الحصول على القفل — فحص آخر (دوري أو عميق) قيد التنفيذ بالفعل'); return; }
  const وقت_البدء = new Date();
  try {
    const نتيجة_محطات = فحص_احداثيات_المحطات_العميق_();
    تحديث_حالة_المشروع_(نتيجة_محطات.اسم_المشروع, نتيجة_محطات.سليم);

    // Level 4 Phase 1 — لا تحديث لـ"الرئيسية" هنا عمدًا (انظر تعليق الدالة أعلاه)، ولا بريد مستقل
    // (تشغيل_الفحص_العميق_اليومي لا يرسل بريدًا أصلاً) — فقط تسجيل تاريخي + تحليل اتجاهات
    const نتيجة_عائلة = فحص_عائلة_السلامي_العميق_();

    const كل_النتائج = [نتيجة_محطات, نتيجة_عائلة];

    // Level 5 — يُسجَّل التاريخ دائمًا، لكن يبقى صامتًا بالبريد (قرار سابق). أي تصعيد يُكتشَف هنا
    // (مثال: فشل getStats مرتين متتاليتين بفحصين عميقين) يُحفَظ ليظهر بأول تقرير دوري لاحق، بدل أن
    // يُفقَد كليًا لمجرد أن مصدره فحص صامت — انظر حفظ_ملاحظات_عميقة_معلّقة_ في HistoryLog.gs
    const سجل_سابق = قراءة_سجل_فحوص_مجمَّع_();
    const ملاحظات = تحليل_الاتجاهات_(كل_النتائج, 'عميق', سجل_سابق);
    حفظ_ملاحظات_عميقة_معلّقة_(ملاحظات);

    تسجيل_تاريخ_التشغيل_('عميق', وقت_البدء, new Date(), كل_النتائج, false);
  } finally {
    قفل.releaseLock();
  }
}

/** يستخرج نص وصف الخطأ من نتيجة استدعاء_api_ لعرضه بالتقرير */
function وصف_الخطأ_(نتيجة_استدعاء) {
  if (!نتيجة_استدعاء.نجح) return نتيجة_استدعاء.خطأ || 'تعذّر الاتصال';
  const ب = نتيجة_استدعاء.بيانات;
  return (ب && (ب.error || ب.message)) || 'خطأ غير معروف';
}

/**
 * يحدّث "الحالة العامة" و"نسبة السلامة" و"آخر فحص" لمشروع في جدول
 * "الرئيسية" بناءً على نتيجة الفحص، ويُرجع الحالة النهائية المكتوبة
 * فعليًا (ليستخدمها المستدعي — مثل تقرير الإيميل — بدل إعادة حسابها
 * بطريقة منفصلة قد تتعارض مع ما كُتب في الجدول).
 *
 * لو كانت هناك حالات/أخطاء مفتوحة مسجَّلة لذلك المشروع، تصير الحالة
 * "تحذير" بدل "سليم" حتى لو الفحص الأساسي نجح — لأن وجود خطأ مسجَّل
 * غير محلول هو تحذير حقيقي بحد ذاته.
 *
 * سليم=null (فحص معطّل مؤقتًا) → لا يُكتب شيء، حفاظًا على عدم كتابة
 * بيانات غير مؤكدة، ويُرجع null.
 *
 * @return {{حالة:string, نسبة:number}|null}
 */
function تحديث_حالة_المشروع_(اسم_المشروع, سليم) {
  if (سليم === null) return null;

  const الملف = SpreadsheetApp.openById(معرف_الشيت);
  const ورقة_الرئيسية = الملف.getSheetByName(اسم_ورقة_الرئيسية);
  const صف = البحث_عن_صف_المشروع(ورقة_الرئيسية, اسم_المشروع);
  if (!صف) return null;

  const رقم_عمود_عدد_الأخطاء = أعمدة_الرئيسية.indexOf('عدد الأخطاء المفتوحة') + 1;
  const عدد_الأخطاء = Number(ورقة_الرئيسية.getRange(صف, رقم_عمود_عدد_الأخطاء).getValue()) || 0;

  const حالة = !سليم ? 'متوقف' : (عدد_الأخطاء > 0 ? 'تحذير' : 'سليم');
  // النسبة تعكس شدة الحالات المفتوحة فعليًا — وليست 100% ثابتة كلما كان
  // الفحص الفني ناجحًا، حتى لا تتناقض "تحذير" مع "100%" في نفس الصف
  const نسبة = !سليم ? 0 : Math.max(0, 1 - حساب_إجمالي_خصم_الحالات_المفتوحة_(اسم_المشروع));

  const رقم_عمود_الحالة = أعمدة_الرئيسية.indexOf('الحالة العامة') + 1;
  const رقم_عمود_النسبة = أعمدة_الرئيسية.indexOf('نسبة السلامة') + 1;
  const رقم_عمود_آخر_فحص = أعمدة_الرئيسية.indexOf('آخر فحص') + 1;

  ورقة_الرئيسية.getRange(صف, رقم_عمود_الحالة).setValue(حالة);
  ورقة_الرئيسية.getRange(صف, رقم_عمود_النسبة).setValue(نسبة).setNumberFormat('0%');
  ورقة_الرئيسية.getRange(صف, رقم_عمود_آخر_فحص).setValue(new Date());
  إبطال_كاش_اللوحة_(); // بدون هذا تبقى اللوحة تعرض بيانات ما قبل الفحص حتى تنتهي صلاحية الكاش

  return { حالة: حالة, نسبة: نسبة };
}

/**
 * لا تلوين/حكم على عمود "الأداء" حاليًا عمدًا — قرار محمد الصريح: "الأداء الآن = قياس، وليس حكمًا".
 * أي عتبة ثابتة (مثال: >5s = 🔴) مضلِّلة بلا خط أساس تاريخي حقيقي لكل مشروع على حدة (5 ثوانٍ قد
 * تكون طبيعية لمشروع وغير طبيعية لآخر) — هذا بالضبط ما سيبنيه Level 5 (مقارنة بمتوسط كل مشروع
 * الخاص به عبر الزمن). حتى ذلك الحين: نعرض الزمن الخام فقط، بلا لون.
 */

/** يعرض زمنًا بالمللي ثانية كثانية مختصرة (مثال: 51510 → "51.5s") إن تجاوز ثانية كاملة، وإلا كما هو */
function تنسيق_زمن_(زمن_ms) {
  if (زمن_ms >= 1000) return (زمن_ms / 1000).toFixed(1) + 's';
  return زمن_ms + 'ms';
}

/**
 * شارة عرض مُهيكَلة لصف مشروع واحد بالتقرير — طبقة عرض إضافية فوق الحالة الخام المخزَّنة فعليًا
 * بجدول "الرئيسية" (بلا أي تعديل عليها ولا على تحديث_حالة_المشروع_): تميّز بصريًا "سليم بالكامل"
 * عن "سليم لكن فحص ثانوي فشل" — رغم أن كلتيهما "سليم" فعليًا بالجدول (بتصميم Level 2 المتفَق عليه:
 * فشل Secondary لا يُسقط الحالة) — حتى لا يختفي فشل جزئي حقيقي خلف كلمة "سليم" وحدها بالإيميل.
 * @return {{رمز:string, نص:string, لون:string}}
 */
function شارة_عرض_الصف_(نتيجة) {
  if (نتيجة.الحالة_النهائية === null || نتيجة.الحالة_النهائية === undefined) {
    return { رمز: '⚪', نص: 'لم يُفحص', لون: '#999999' };
  }
  if (نتيجة.الحالة_النهائية === 'متوقف') {
    return { رمز: '🔴', نص: 'متوقف', لون: '#c0392b' };
  }
  const يوجد_فشل_ثانوي = (نتيجة.فحوصات || []).some(function (ف) { return !ف.أساسي && ف.الحالة === 'FAIL'; });
  if (يوجد_فشل_ثانوي) {
    return { رمز: '🟠', نص: 'سليم — ملاحظة ثانوية', لون: '#e67e22' };
  }
  if (نتيجة.الحالة_النهائية === 'تحذير') {
    return { رمز: '🟡', نص: 'تحذير', لون: '#e0a800' };
  }
  return { رمز: '🟢', نص: 'سليم', لون: '#5c7a63' };
}

/** نص "التفاصيل" المختصر من فحوصات[] — اسم كل فحص فرعي + رمز حالته (✅ ناجح، ⚠️ ثانوي فاشل، ❌ أساسي فاشل) */
function نص_تفاصيل_الفحوصات_(فحوصات) {
  if (!فحوصات || !فحوصات.length) return '—';
  return فحوصات.map(function (ف) {
    const رمز = ف.الحالة === 'PASS' ? '✅' : (ف.أساسي ? '❌' : '⚠️');
    return ف.اسم + ' ' + رمز;
  }).join('&nbsp;&nbsp;');
}

/**
 * يبني نص HTML لقسم "🔍 ملاحظات تاريخية" (Level 5) — لا يظهر إطلاقًا إن كانت المصفوفة فارغة (لا
 * ضوضاء بلا داعٍ، قرار محمد الصريح: لا تُرسَل ملاحظة إلا عند انتقال حقيقي بين الحالات).
 */
function قسم_الملاحظات_التاريخية_html_(ملاحظات) {
  if (!ملاحظات || !ملاحظات.length) return '';
  const صفوف = ملاحظات.map(function (م) {
    return '<li style="margin-bottom:6px">' + م.شدة + ' ' + م.النص + '</li>';
  }).join('');
  return (
    '<div style="margin-top:16px;padding:12px 14px;background:#f5f5f0;border-radius:6px">' +
    '<div style="font-weight:bold;margin-bottom:6px">🔍 ملاحظات تاريخية</div>' +
    '<ul style="margin:0;padding-inline-start:20px;font-size:12px">' + صفوف + '</ul>' +
    '</div>'
  );
}

/**
 * يبني ويُرسل تقرير الفحص الدوري كإيميل HTML — جدول ملوّن بحالة كل مشروع + أداء (من زمن_ms المقيس
 * فعليًا بـ"استدعاء_api_"/"استدعاء_postgrest_") + تفاصيل كل فحص فرعي (من فحوصات[]) + ملخص عام +
 * قسم "ملاحظات تاريخية" اختياري (Level 5 — محرّك التصعيد في HistoryLog.gs).
 * @param {Array} نتائج
 * @param {Array} [ملاحظات_تاريخية] من تحليل_الاتجاهات_ — تُهمَل إن غابت (توافق خلفي)
 */
function إرسال_تقرير_الفحص_(نتائج, ملاحظات_تاريخية) {
  const الآن = Utilities.formatDate(new Date(), 'Asia/Riyadh', 'yyyy/MM/dd HH:mm');
  const وقت_التنفيذ = Utilities.formatDate(new Date(), 'Asia/Riyadh', 'hh:mm:ss a');

  const عدد_المفحوصة = نتائج.filter(function (ن) { return ن.الحالة_النهائية !== null && ن.الحالة_النهائية !== undefined; }).length;
  const عدد_السليمة = نتائج.filter(function (ن) { return ن.الحالة_النهائية === 'سليم'; }).length;
  const عدد_بها_أخطاء = عدد_المفحوصة - عدد_السليمة;

  let إجمالي_فحوصات = 0, إجمالي_فشل_أساسي = 0, إجمالي_فشل_ثانوي = 0, مجموع_الأزمنة = 0, عدد_الأزمنة = 0;
  نتائج.forEach(function (ن) {
    (ن.فحوصات || []).forEach(function (ف) {
      إجمالي_فحوصات++;
      if (ف.الحالة === 'FAIL' && ف.أساسي) إجمالي_فشل_أساسي++;
      if (ف.الحالة === 'FAIL' && !ف.أساسي) إجمالي_فشل_ثانوي++;
      مجموع_الأزمنة += ف.زمن_ms || 0;
      عدد_الأزمنة++;
    });
  });
  const متوسط_الاستجابة = عدد_الأزمنة > 0 ? Math.round(مجموع_الأزمنة / عدد_الأزمنة) : 0;
  const نتيجة_عامة = عدد_بها_أخطاء === 0 ? '🟢 جميع المشاريع تعمل' : '🔴 ' + عدد_بها_أخطاء + ' مشروع يحتاج انتباهًا';

  const صفوف = نتائج.map(function (نتيجة) {
    const شارة = شارة_عرض_الصف_(نتيجة);
    const نسبة = (نتيجة.النسبة_النهائية !== null && نتيجة.النسبة_النهائية !== undefined)
      ? Math.round(نتيجة.النسبة_النهائية * 100) + '%'
      : '—';
    const زمن_المشروع = (نتيجة.فحوصات || []).reduce(function (s, ف) { return s + (ف.زمن_ms || 0); }, 0);
    const أداء = (نتيجة.فحوصات && نتيجة.فحوصات.length) ? تنسيق_زمن_(زمن_المشروع) : '—';
    const تفاصيل = (نتيجة.فحوصات && نتيجة.فحوصات.length) ? نص_تفاصيل_الفحوصات_(نتيجة.فحوصات) : (نتيجة.ملاحظة || '—');

    return '<tr>' +
      '<td style="padding:10px;border:1px solid #ddd;text-align:center;font-weight:bold;font-size:12px;">' + نتيجة.اسم_المشروع + '</td>' +
      '<td style="padding:10px;border:1px solid #ddd;text-align:center;font-weight:bold;font-size:12px;color:#fff;background:' + شارة.لون + ';">' + شارة.رمز + ' ' + شارة.نص + '</td>' +
      '<td style="padding:10px;border:1px solid #ddd;text-align:center;font-weight:bold;font-size:12px;">' + نسبة + '</td>' +
      '<td style="padding:10px;border:1px solid #ddd;text-align:center;font-size:12px;">' + أداء + '</td>' +
      '<td style="padding:10px;border:1px solid #ddd;text-align:right;font-size:12px;">' + تفاصيل + '</td>' +
      '</tr>';
  }).join('');

  const جسم_الرسالة =
    '<div dir="rtl" style="font-family:Tahoma,Arial,sans-serif;">' +
    '<h2 style="color:#5c7a63;">تقرير فحص مدير المشاريع الذكي</h2>' +
    '<p>' + الآن + ' (بتوقيت السعودية)</p>' +
    '<p style="font-weight:bold">' + عدد_المفحوصة + ' مشاريع مفحوصة | ' + عدد_السليمة + ' سليمة | ' + عدد_بها_أخطاء + ' بها ملاحظات</p>' +
    '<p style="font-weight:bold">النتيجة العامة: ' + نتيجة_عامة + '</p>' +
    '<table style="border-collapse:collapse;width:100%;">' +
    '<tr style="background:#5c7a63;color:#fff;">' +
    '<th style="padding:10px;border:1px solid #ddd;font-size:12px;">المشروع</th>' +
    '<th style="padding:10px;border:1px solid #ddd;font-size:12px;">الحالة</th>' +
    '<th style="padding:10px;border:1px solid #ddd;font-size:12px;">الصحة</th>' +
    '<th style="padding:10px;border:1px solid #ddd;font-size:12px;">الأداء</th>' +
    '<th style="padding:10px;border:1px solid #ddd;font-size:12px;">التفاصيل</th>' +
    '</tr>' +
    صفوف +
    '</table>' +
    '<p style="font-size:11px;color:#666;margin-top:14px">' +
      'الفحوصات: ' + إجمالي_فحوصات + ' | الناجحة: ' + (إجمالي_فحوصات - إجمالي_فشل_أساسي - إجمالي_فشل_ثانوي) +
      ' | الفاشلة: ' + (إجمالي_فشل_أساسي + إجمالي_فشل_ثانوي) +
    '</p>' +
    '<p style="font-size:11px;color:#666">' +
      'Core failures: ' + إجمالي_فشل_أساسي + ' | Secondary failures: ' + إجمالي_فشل_ثانوي +
    '</p>' +
    '<p style="font-size:11px;color:#666">' +
      'متوسط زمن الفحص: ' + تنسيق_زمن_(متوسط_الاستجابة) + ' | وقت التنفيذ: ' + وقت_التنفيذ +
    '</p>' +
    قسم_الملاحظات_التاريخية_html_(ملاحظات_تاريخية) +
    '</div>';

  MailApp.sendEmail({
    to: البريد_المستلم_للتقرير,
    subject: 'تقرير فحص مدير المشاريع الذكي — ' + الآن,
    htmlBody: جسم_الرسالة
  });
}

/**
 * يُنشئ مشغّلين زمنيين لتشغيل الفحص الدوري تلقائيًا الساعة 12 منتصف
 * الليل و12 ظهرًا (بتوقيت السعودية) كل يوم. تُشغَّل يدويًا مرة واحدة.
 * تحذف أي مشغلات سابقة لنفس الدالة أولًا لتفادي التكرار عند إعادة التشغيل.
 */
function تفعيل_مشغل_الفحص_الدوري() {
  ScriptApp.getProjectTriggers().forEach(function (مشغل) {
    if (مشغل.getHandlerFunction() === 'تشغيل_الفحص_الدوري') {
      ScriptApp.deleteTrigger(مشغل);
    }
  });

  ScriptApp.newTrigger('تشغيل_الفحص_الدوري').timeBased().atHour(0).everyDays(1).create();
  ScriptApp.newTrigger('تشغيل_الفحص_الدوري').timeBased().atHour(12).everyDays(1).create();
}

/**
 * يُنشئ مشغّلًا زمنيًا للفحص العميق اليومي (احداثيات المحطات تحديدًا الآن) الساعة 3 فجرًا بتوقيت
 * السعودية — بعيدًا عن مواعيد الفحص الدوري (12ص/12ظ) لتفادي أي تداخل، رغم وجود LockService كحماية
 * إضافية. تُشغَّل يدويًا مرة واحدة. تحذف أي مشغلات سابقة لنفس الدالة أولًا لتفادي التكرار.
 */
function تفعيل_مشغل_الفحص_العميق_اليومي() {
  ScriptApp.getProjectTriggers().forEach(function (مشغل) {
    if (مشغل.getHandlerFunction() === 'تشغيل_الفحص_العميق_اليومي') {
      ScriptApp.deleteTrigger(مشغل);
    }
  });

  ScriptApp.newTrigger('تشغيل_الفحص_العميق_اليومي').timeBased().atHour(3).everyDays(1).create();
}
