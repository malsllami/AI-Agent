/**
 * دوال إدارة الحالات (الأخطاء/المشاكل المكتشفة): تسجيل حالة جديدة في جدول
 * تفاصيل مشروع معيّن. دالة `إضافة_حالة` عامة وقابلة لإعادة الاستخدام —
 * ستُستخدم مستقبلًا لأي حالة تُكتشف يدويًا أو عبر الفحص الآلي.
 *
 * Case management functions: logging a new discovered issue into a
 * project's detail sheet. `إضافة_حالة` is generic and reusable for any
 * future case, whether found manually or by the automated check.
 */

/**
 * يضيف حالة (خطأ/مشكلة مكتشفة) جديدة لجدول تفاصيل مشروع معيّن، ويحدّث
 * تلقائيًا "عدد الأخطاء المفتوحة" في جدول "الرئيسية" لذلك المشروع.
 * "القرار" يُسجَّل دائمًا "بانتظار الرد" و"حالة التنفيذ" "لم يبدأ" —
 * لا تنفيذ إصلاح فعلي إطلاقًا من هذه الدالة، تسجيل واقتراح فقط.
 *
 * Adds a new discovered case to a project's detail sheet, and updates
 * "عدد الأخطاء المفتوحة" in the "الرئيسية" row for that project.
 * "القرار" is always logged as "بانتظار الرد" and "حالة التنفيذ" as
 * "لم يبدأ" — this only logs and proposes, it never fixes anything.
 *
 * @param {string} اسم_المشروع
 * @param {{نوع_الحالة:string, شدة_الحالة:string, الوصف:string, الخطة_المقترحة:string}} بيانات
 * @return {string} رقم الحالة المُنشأة
 */
function إضافة_حالة(اسم_المشروع, بيانات) {
  const الملف = SpreadsheetApp.openById(معرف_الشيت);
  const ورقة = الحصول_على_ورقة_أو_إنشاؤها(الملف, اسم_المشروع);
  تنسيق_الجدول(ورقة, أعمدة_تفاصيل_المشروع);

  const الآن = new Date();
  const رقم_الحالة = 'ح-' + Utilities.formatDate(الآن, 'Asia/Riyadh', 'yyyyMMdd-HHmmss');

  const صف = {
    'رقم الحالة': رقم_الحالة,
    'تاريخ ووقت الاكتشاف': الآن,
    'نوع الحالة': بيانات.نوع_الحالة,
    'شدة الحالة': بيانات.شدة_الحالة,
    'الوصف': بيانات.الوصف,
    'الخطة المقترحة': بيانات.الخطة_المقترحة,
    'القرار': 'بانتظار الرد',
    'ملاحظات تعديلي': '',
    'حالة التنفيذ': 'لم يبدأ',
    'تاريخ آخر تحديث': الآن
  };

  const صف_جديد = ورقة.getLastRow() + 1;
  أعمدة_تفاصيل_المشروع.forEach(function (عمود, i) {
    ورقة.getRange(صف_جديد, i + 1).setValue(صف[عمود]);
  });

  تلوين_شدة_الحالة_شرطيًا(ورقة, أعمدة_تفاصيل_المشروع.indexOf('شدة الحالة') + 1);
  تحديث_عدد_الأخطاء_المفتوحة_(اسم_المشروع);

  return رقم_الحالة;
}

/**
 * يعيد حساب "عدد الأخطاء المفتوحة" لمشروع معيّن في جدول "الرئيسية"
 * (عدد الحالات التي حالة تنفيذها ليست "متم بالكامل") ويحدّثه.
 *
 * Recomputes "عدد الأخطاء المفتوحة" for a project in the "الرئيسية"
 * sheet (count of cases whose execution status isn't "متم بالكامل").
 *
 * @param {string} اسم_المشروع
 */
function تحديث_عدد_الأخطاء_المفتوحة_(اسم_المشروع) {
  const الملف = SpreadsheetApp.openById(معرف_الشيت);
  const ورقة_التفاصيل = الملف.getSheetByName(اسم_المشروع);
  const ورقة_الرئيسية = الملف.getSheetByName(اسم_ورقة_الرئيسية);
  if (!ورقة_التفاصيل || !ورقة_الرئيسية) return;

  const صف_المشروع = البحث_عن_صف_المشروع(ورقة_الرئيسية, اسم_المشروع);
  if (!صف_المشروع) return;

  const رقم_عمود_حالة_التنفيذ = أعمدة_تفاصيل_المشروع.indexOf('حالة التنفيذ') + 1;
  const آخر_صف = ورقة_التفاصيل.getLastRow();
  let عدد_مفتوحة = 0;
  if (آخر_صف >= 2) {
    const القيم = ورقة_التفاصيل.getRange(2, رقم_عمود_حالة_التنفيذ, آخر_صف - 1, 1).getValues();
    عدد_مفتوحة = القيم.filter(function (صف) { return صف[0] !== 'متم بالكامل' && صف[0] !== ''; }).length;
  }

  const رقم_عمود_عدد_الأخطاء = أعمدة_الرئيسية.indexOf('عدد الأخطاء المفتوحة') + 1;
  ورقة_الرئيسية.getRange(صف_المشروع, رقم_عمود_عدد_الأخطاء).setValue(عدد_مفتوحة);
}

/**
 * تهيئة لمرة واحدة: تسجّل الحالتين المكتشفتين في مشروع "احداثيات المحطات"
 * أثناء مراجعة تصميم الفحص الآلي (بيانات مكشوفة بدون تسجيل دخول،
 * والبصمة إجبارية بلا بديل). تُشغَّل يدويًا مرة واحدة من محرر Apps Script.
 */
function تسجيل_حالات_احداثيات_المحطات_الأولية() {
  إضافة_حالة('احداثيات المحطات', {
    نوع_الحالة: 'خطأ صامت',
    شدة_الحالة: 'حرجة متوسطة',
    الوصف: 'بيانات المحطات (قائمة المحطات، البحث، الإحصائيات) يمكن الوصول إليها وتحميلها بالكامل عبر واجهة البرمجة (API) دون أي تسجيل دخول أو تحقق من الهوية. أي شخص يعرف رابط الموقع يستطيع الوصول لهذه البيانات مباشرة دون أن يظهر أي خطأ للمستخدمين العاديين.',
    الخطة_المقترحة: 'إضافة تحقق من هوية المستخدم (رقم جوال مسجَّل ونشط على الأقل) قبل إرجاع بيانات المحطات في الدوال المعنية (عرض قائمة المحطات، البحث، الإحصائيات، المحطات القريبة).'
  });

  إضافة_حالة('احداثيات المحطات', {
    نوع_الحالة: 'لا يتوقف الموقع لكن يسبب أخطاء ظاهرة تعيق المستخدمين',
    شدة_الحالة: 'حرجة جدًا',
    الوصف: 'تسجيل الدخول في النظام يعتمد بالكامل على البصمة (WebAuthn) دون وجود أي مسار دخول بديل. أي مستخدم فقد جهازه، غيّره، أو لا يدعم جهازه البصمة، لا يستطيع الدخول للنظام نهائيًا.',
    الخطة_المقترحة: 'إضافة مسار تسجيل دخول أساسي بديل (مثل رقم الجوال فقط، بنفس النمط المستخدم في مشروع سهم)، وتحويل البصمة إلى خطوة أمان إضافية اختيارية بعد الدخول الأساسي — بدل أن تكون الشرط الوحيد للدخول.'
  });
}
