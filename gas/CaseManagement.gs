/**
 * دوال إدارة الحالات (الأخطاء/المشاكل المكتشفة): تسجيل حالة جديدة في جدول
 * تفاصيل مشروع معيّن. دالة `إضافة_حالة` عامة وقابلة لإعادة الاستخدام —
 * ستُستخدم مستقبلًا لأي حالة تُكتشف يدويًا أو عبر الفحص الآلي.
 *
 * Case management functions: logging a new discovered issue into a
 * project's detail sheet. `إضافة_حالة` is generic and reusable for any
 * future case, whether found manually or by the automated check.
 */

/**
 * يضيف حالة (خطأ/مشكلة مكتشفة) جديدة لجدول تفاصيل مشروع معيّن، ويحدّث
 * تلقائيًا "عدد الأخطاء المفتوحة" في جدول "الرئيسية" لذلك المشروع.
 * "القرار" يُسجَّل دائمًا "بانتظار الرد" و"حالة التنفيذ" "لم يبدأ" —
 * لا تنفيذ إصلاح فعلي إطلاقًا من هذه الدالة، تسجيل واقتراح فقط.
 *
 * Adds a new discovered case to a project's detail sheet, and updates
 * "عدد الأخطاء المفتوحة" in the "الرئيسية" row for that project.
 * "القرار" is always logged as "بانتظار الرد" and "حالة التنفيذ" as
 * "لم يبدأ" — this only logs and proposes, it never fixes anything.
 *
 * Idempotent: لو كانت هناك حالة موجودة مسبقًا بنفس الوصف بالضبط في نفس
 * ورقة المشروع، لا تُضاف حالة مكررة — تُرجع رقم الحالة الموجودة فعليًا.
 *
 * @param {string} اسم_المشروع
 * @param {{نوع_الحالة:string, شدة_الحالة:string, الوصف:string, الخطة_المقترحة:string}} بيانات
 * @return {string} رقم الحالة (الجديدة، أو الموجودة مسبقًا إن كانت مكررة)
 */
function إضافة_حالة(اسم_المشروع, بيانات) {
  const الملف = SpreadsheetApp.openById(معرف_الشيت);
  const ورقة = الحصول_على_ورقة_أو_إنشاؤها(الملف, اسم_المشروع);
  تنسيق_الجدول(ورقة, أعمدة_تفاصيل_المشروع);

  const رقم_موجود = البحث_عن_حالة_بنفس_الوصف_(ورقة, بيانات.الوصف);
  if (رقم_موجود) return رقم_موجود;

  const الآن = new Date();
  const رقم_الحالة = 'ح-' + Utilities.formatDate(الآن, 'Asia/Riyadh', 'yyyyMMdd-HHmmss');

  const صف = {
    'رقم الحالة': رقم_الحالة,
    'تاريخ ووقت الاكتشاف': الآن,
    'نوع الحالة': بيانات.نوع_الحالة,
    'شدة الحالة': بيانات.شدة_الحالة,
    'الوصف': بيانات.الوصف,
    'الخطة المقترحة': بيانات.الخطة_المقترحة,
    'القرار': 'بانتظار الرد',
    'ملاحظات تعديلي': '',
    'حالة التنفيذ': 'لم يبدأ',
    'تاريخ آخر تحديث': الآن
  };

  const صف_جديد = ورقة.getLastRow() + 1;
  أعمدة_تفاصيل_المشروع.forEach(function (عمود, i) {
    ورقة.getRange(صف_جديد, i + 1).setValue(صف[عمود]);
  });

  تلوين_شدة_الحالة_شرطيًا(ورقة, أعمدة_تفاصيل_المشروع.indexOf('شدة الحالة') + 1);
  تحديث_عدد_الأخطاء_المفتوحة_(اسم_المشروع);

  return رقم_الحالة;
}

/**
 * يبحث في ورقة تفاصيل مشروع عن حالة موجودة بنفس نص "الوصف" بالضبط —
 * يمنع `إضافة_حالة` من تكرار نفس الحالة لو استُدعيت أكثر من مرة.
 *
 * @param {Sheet} ورقة
 * @param {string} الوصف
 * @return {string|null} رقم الحالة الموجودة، أو null إن لم توجد
 */
function البحث_عن_حالة_بنفس_الوصف_(ورقة, الوصف) {
  const آخر_صف = ورقة.getLastRow();
  if (آخر_صف < 2) return null;

  const رقم_عمود_رقم_الحالة = أعمدة_تفاصيل_المشروع.indexOf('رقم الحالة') + 1;
  const رقم_عمود_الوصف = أعمدة_تفاصيل_المشروع.indexOf('الوصف') + 1;
  const القيم = ورقة.getRange(2, 1, آخر_صف - 1, أعمدة_تفاصيل_المشروع.length).getValues();

  for (let i = 0; i < القيم.length; i++) {
    if (القيم[i][رقم_عمود_الوصف - 1] === الوصف) {
      return القيم[i][رقم_عمود_رقم_الحالة - 1];
    }
  }
  return null;
}

/**
 * يعيد حساب "عدد الأخطاء المفتوحة" لمشروع معيّن في جدول "الرئيسية"
 * (عدد الحالات التي حالة تنفيذها ليست "متم بالكامل") ويحدّثه.
 *
 * Recomputes "عدد الأخطاء المفتوحة" for a project in the "الرئيسية"
 * sheet (count of cases whose execution status isn't "متم بالكامل").
 *
 * @param {string} اسم_المشروع
 */
function تحديث_عدد_الأخطاء_المفتوحة_(اسم_المشروع) {
  const الملف = SpreadsheetApp.openById(معرف_الشيت);
  const ورقة_التفاصيل = الملف.getSheetByName(اسم_المشروع);
  const ورقة_الرئيسية = الملف.getSheetByName(اسم_ورقة_الرئيسية);
  if (!ورقة_التفاصيل || !ورقة_الرئيسية) return;

  const صف_المشروع = البحث_عن_صف_المشروع(ورقة_الرئيسية, اسم_المشروع);
  if (!صف_المشروع) return;

  const رقم_عمود_حالة_التنفيذ = أعمدة_تفاصيل_المشروع.indexOf('حالة التنفيذ') + 1;
  const آخر_صف = ورقة_التفاصيل.getLastRow();
  let عدد_مفتوحة = 0;
  if (آخر_صف >= 2) {
    const القيم = ورقة_التفاصيل.getRange(2, رقم_عمود_حالة_التنفيذ, آخر_صف - 1, 1).getValues();
    عدد_مفتوحة = القيم.filter(function (صف) { return صف[0] !== 'متم بالكامل' && صف[0] !== ''; }).length;
  }

  const رقم_عمود_عدد_الأخطاء = أعمدة_الرئيسية.indexOf('عدد الأخطاء المفتوحة') + 1;
  ورقة_الرئيسية.getRange(صف_المشروع, رقم_عمود_عدد_الأخطاء).setValue(عدد_مفتوحة);

  // إبطال كاش اللوحة فورًا — بدون هذا، اللوحة تستمر تعرض بيانات قديمة
  // حتى تنتهي صلاحية الكاش (300 ثانية) رغم أن الجدول تحدَّث فعليًا
  إبطال_كاش_اللوحة_();
}

/**
 * يحدّث "القرار" و"حالة التنفيذ" لحالة واحدة محدَّدة برقمها — يُستخدم
 * لتسجيل ما تم إنجازه فعليًا خارج اللوحة (تنفيذ يدوي مباشر في كود
 * مشروع آخر)، تمييزًا عن تحديث_قرار_حالة_ في WebApi.gs التي تُحدّث
 * "القرار" فقط استجابة لضغطة زر من اللوحة.
 *
 * @param {string} اسم_المشروع
 * @param {string} رقم_الحالة
 * @param {string} القرار
 * @param {string} حالة_التنفيذ
 * @param {string} [ملاحظة]
 */
function تحديث_حالة_كاملة_(اسم_المشروع, رقم_الحالة, القرار, حالة_التنفيذ, ملاحظة) {
  const الملف = SpreadsheetApp.openById(معرف_الشيت);
  const ورقة = الملف.getSheetByName(اسم_المشروع);
  if (!ورقة) return;

  const رقم_عمود_رقم_الحالة = أعمدة_تفاصيل_المشروع.indexOf('رقم الحالة') + 1;
  const رقم_عمود_القرار = أعمدة_تفاصيل_المشروع.indexOf('القرار') + 1;
  const رقم_عمود_حالة_التنفيذ = أعمدة_تفاصيل_المشروع.indexOf('حالة التنفيذ') + 1;
  const رقم_عمود_ملاحظات = أعمدة_تفاصيل_المشروع.indexOf('ملاحظات تعديلي') + 1;
  const رقم_عمود_آخر_تحديث = أعمدة_تفاصيل_المشروع.indexOf('تاريخ آخر تحديث') + 1;

  const آخر_صف = ورقة.getLastRow();
  const أرقام = ورقة.getRange(2, رقم_عمود_رقم_الحالة, آخر_صف - 1, 1).getValues();
  for (let i = 0; i < أرقام.length; i++) {
    if (أرقام[i][0] === رقم_الحالة) {
      const صف = i + 2;
      ورقة.getRange(صف, رقم_عمود_القرار).setValue(القرار);
      ورقة.getRange(صف, رقم_عمود_حالة_التنفيذ).setValue(حالة_التنفيذ);
      if (ملاحظة) ورقة.getRange(صف, رقم_عمود_ملاحظات).setValue(ملاحظة);
      ورقة.getRange(صف, رقم_عمود_آخر_تحديث).setValue(new Date());
      break;
    }
  }
  تحديث_عدد_الأخطاء_المفتوحة_(اسم_المشروع);
}

/**
 * تسجيل لمرة واحدة: يحدّث حالة "بيانات المحطات بدون تسجيل دخول" —
 * حُلَّت بالكامل (تحقق هوية إجباري على 4 دوال بيانات محطات).
 */
function تحديث_حالة_بيانات_المحطات_بعد_الإصلاح() {
  تحديث_حالة_كاملة_(
    'احداثيات المحطات', 'ح-20260824-203213', 'موافقة', 'متم بالكامل',
    'أُضيف تحقق إجباري من هوية عضو نشط قبل تنفيذ: عرض قائمة المحطات، البحث، الإحصائيات، والمحطات القريبة. صفحتا الدخول/المراسلة وتقويم الورديات لم تتأثرا (لا تستخدمان هذه الدوال).'
  );
}

/** تشخيص مؤقت: يطبع محتوى جدول تفاصيل احداثيات المحطات كاملًا بالسجل */
function تشخيص_جدول_احداثيات_المحطات() {
  const الملف = SpreadsheetApp.openById(معرف_الشيت);
  const ورقة = الملف.getSheetByName('احداثيات المحطات');
  const آخر_صف = ورقة.getLastRow();
  const القيم = ورقة.getRange(1, 1, آخر_صف, أعمدة_تفاصيل_المشروع.length).getValues();
  القيم.forEach(function (صف, i) {
    Logger.log('صف ' + (i + 1) + ': ' + JSON.stringify(صف));
  });
}

/**
 * تسجيل لمرة واحدة: يحدّث حالتي احداثيات المحطات اللتين نُفِّذ إصلاح
 * فعلي لهما مباشرة في كود ذلك المشروع (خارج اللوحة)، حتى يعكس
 * السجل الواقع الفعلي بدل البقاء عالقًا على "بانتظار الرد".
 */
function تحديث_حالات_احداثيات_المحطات_بعد_الإصلاح() {
  // الحالة ٢: البصمة إجبارية بلا بديل — حُلَّت بالكامل (مسار دخول
  // بديل برقم الجوال + البصمة اختيارية حتى عند التسجيل)
  تحديث_حالة_كاملة_(
    'احداثيات المحطات', 'ح-20260824-203216', 'موافقة', 'متم بالكامل',
    'أُضيف مسار دخول بديل برقم الجوال (يمنح صلاحية عضو عادي فقط)، وأصبحت البصمة اختيارية بالكامل حتى عند تسجيل عضو جديد.'
  );

  // الحالة ٣: لا تذكرة دخول موقّعة (رقم الجوال كمعرّف هوية) — حُلَّ
  // جزء "انتحال صلاحية المدير" فقط عبر فصل رقم مدير سري منفصل؛
  // بقية الوظائف الحساسة (كالملف الشخصي لعضو عادي) لم تُمس بعد
  تحديث_حالة_كاملة_(
    'احداثيات المحطات', 'ح-20260824-224754', 'موافقة', 'جاري التنفيذ جزئيًا',
    'حُلَّ جزء صلاحية المدير: رقم جوال المدير السري أصبح منفصلًا تمامًا عن رقم التواصل العام، ودخول رقم الجوال يمنح دائمًا عضوًا عاديًا. لم يُبنَ بعد نظام تذكرة موقّعة شامل لبقية الوظائف الحساسة (كالملف الشخصي لعضو عادي).'
  );
}

/**
 * تنظيف لمرة واحدة: يحذف صفي الحالتين اللتين تكررتا بالخطأ في
 * "احداثيات المحطات" (نسخة طبق الأصل عن الحالتين الأصليتين، ناتجة عن
 * تشغيل دالة التسجيل الأولي مرتين قبل إصلاح idempotency في إضافة_حالة).
 * تُشغَّل يدويًا مرة واحدة بموافقة محمد الصريحة.
 */
function حذف_الحالات_المكررة_بالخطأ() {
  حذف_حالة_برقمها_('احداثيات المحطات', 'ح-20260824-223825');
  حذف_حالة_برقمها_('احداثيات المحطات', 'ح-20260824-223828');
}

/**
 * يحذف صفًا واحدًا محدَّدًا برقم الحالة بالضبط من جدول تفاصيل مشروع،
 * ويحدّث "عدد الأخطاء المفتوحة" في جدول "الرئيسية" فورًا بعد الحذف.
 *
 * @param {string} اسم_المشروع
 * @param {string} رقم_الحالة
 */
function حذف_حالة_برقمها_(اسم_المشروع, رقم_الحالة) {
  const الملف = SpreadsheetApp.openById(معرف_الشيت);
  const ورقة = الملف.getSheetByName(اسم_المشروع);
  if (!ورقة) return;

  const رقم_عمود_رقم_الحالة = أعمدة_تفاصيل_المشروع.indexOf('رقم الحالة') + 1;
  const آخر_صف = ورقة.getLastRow();
  if (آخر_صف < 2) return;

  const أرقام = ورقة.getRange(2, رقم_عمود_رقم_الحالة, آخر_صف - 1, 1).getValues();
  for (let i = أرقام.length - 1; i >= 0; i--) {
    if (أرقام[i][0] === رقم_الحالة) {
      ورقة.deleteRow(i + 2);
    }
  }
  تحديث_عدد_الأخطاء_المفتوحة_(اسم_المشروع);
}

/**
 * يحسب إجمالي نسبة الخصم (0 إلى 1) الناتج عن كل الحالات المفتوحة في
 * جدول تفاصيل مشروع معيّن، حسب وزن شدة كل حالة (أوزان_خصم_شدة_الحالة).
 * يُستخدم لحساب "نسبة السلامة" الحقيقية بدل تثبيتها 100% كلما كان
 * الفحص التقني ناجحًا مع وجود حالات مفتوحة غير محلولة.
 *
 * @param {string} اسم_المشروع
 * @return {number} إجمالي الخصم (قد يتجاوز 1 لو تراكمت حالات كثيرة —
 *   المستدعي هو من يحدّه عند 0 كحد أدنى للنسبة النهائية)
 */
function حساب_إجمالي_خصم_الحالات_المفتوحة_(اسم_المشروع) {
  const الملف = SpreadsheetApp.openById(معرف_الشيت);
  const ورقة_التفاصيل = الملف.getSheetByName(اسم_المشروع);
  if (!ورقة_التفاصيل) return 0;

  const آخر_صف = ورقة_التفاصيل.getLastRow();
  if (آخر_صف < 2) return 0;

  const رقم_عمود_الشدة = أعمدة_تفاصيل_المشروع.indexOf('شدة الحالة') + 1;
  const رقم_عمود_حالة_التنفيذ = أعمدة_تفاصيل_المشروع.indexOf('حالة التنفيذ') + 1;
  const القيم = ورقة_التفاصيل.getRange(2, 1, آخر_صف - 1, أعمدة_تفاصيل_المشروع.length).getValues();

  return القيم.reduce(function (إجمالي, صف) {
    const حالة_التنفيذ = صف[رقم_عمود_حالة_التنفيذ - 1];
    const الشدة = صف[رقم_عمود_الشدة - 1];
    const مفتوحة = حالة_التنفيذ !== 'متم بالكامل' && حالة_التنفيذ !== '';
    return إجمالي + (مفتوحة ? (أوزان_خصم_شدة_الحالة[الشدة] || 0) : 0);
  }, 0);
}

/**
 * تسجيل لمرة واحدة: حالة أمنية ثالثة مكتشفة في "احداثيات المحطات" أثناء
 * مراجعة آلية تسجيل الدخول — بعد نجاح البصمة، الموقع لا يُصدر أي تذكرة
 * دخول موقّعة، بل يعتمد على رقم الجوال الخام كمعرّف هوية في كل طلب لاحق
 * (الملف الشخصي، لوحة العمليات، ...) — وليس فقط بيانات المحطات العامة.
 * تُشغَّل يدويًا مرة واحدة من محرر Apps Script. آمنة لإعادة التشغيل.
 */
function تسجيل_حالة_ضعف_الهوية_بعد_تسجيل_الدخول() {
  إضافة_حالة('احداثيات المحطات', {
    نوع_الحالة: 'خطأ صامت',
    شدة_الحالة: 'حرجة جدًا',
    الوصف: 'بعد نجاح تسجيل الدخول بالبصمة، الموقع لا يُصدر أي تذكرة دخول (جلسة) موقّعة من الخادم — بل يعتمد على رقم جوال المستخدم نفسه كمعرّف هوية في كل طلب لاحق (عرض الملف الشخصي، لوحة العمليات، وغيرها). رقم الجوال ليس سرًا؛ أي شخص يعرف رقم جوال عضو نشط في النظام يستطيع انتحال هويته بالكامل والوصول لبياناته الشخصية، دون الحاجة لتجاوز البصمة إطلاقًا. هذه المشكلة أوسع من مجرد بيانات المحطات العامة — تمس كل وظيفة تعتمد على رقم الجوال كمعرّف هوية.',
    الخطة_المقترحة: 'بعد نجاح التحقق من البصمة (verifyAssertion)، يُصدر الخادم تذكرة دخول موقّعة (نفس أسلوب issueSessionToken_ المستخدم في مشروع تصاريح العمل)، وتُستخدم هذه التذكرة — وليس رقم الجوال الخام — للتحقق من الهوية في كل طلب لاحق بما فيها بيانات المحطات.'
  });
}

/**
 * تهيئة لمرة واحدة: تسجّل الحالتين المكتشفتين في مشروع "احداثيات المحطات"
 * أثناء مراجعة تصميم الفحص الآلي (بيانات مكشوفة بدون تسجيل دخول،
 * والبصمة إجبارية بلا بديل). تُشغَّل يدويًا مرة واحدة من محرر Apps Script.
 */
function تسجيل_حالات_احداثيات_المحطات_الأولية() {
  إضافة_حالة('احداثيات المحطات', {
    نوع_الحالة: 'خطأ صامت',
    شدة_الحالة: 'حرجة متوسطة',
