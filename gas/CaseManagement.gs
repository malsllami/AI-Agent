/**
 * دوال إدارة الحالات (الأخطاء/المشاكل المكتشفة): تسجيل حالة جديدة في جدول
 * تفاصيل مشروع معيّن. دالة `إضافة_حالة` عامة وقابلة لإعادة الاستخدام —
 * ستُستخدم مستقبلًا لأي حالة تُكتشف يدويًا أو عبر الفحص الآلي.
 *
 * Case management functions: logging a new discovered issue into a
 * project's detail sheet. `إضافة_حالة` is generic and reusable for any
 * future case, whether found manually or by the automated check.
 */

/**
 * يضيف حالة (خطأ/مشكلة مكتشفة) جديدة لجدول تفاصيل مشروع معيّن، ويحدّث
 * تلقائيًا "عدد الأخطاء المفتوحة" في جدول "الرئيسية" لذلك المشروع.
 * "القرار" يُسجَّل دائمًا "بانتظار الرد" و"حالة التنفيذ" "لم يبدأ" —
 * لا تنفيذ إصلاح فعلي إطلاقًا من هذه الدالة، تسجيل واقتراح فقط.
 *
 * Adds a new discovered case to a project's detail sheet, and updates
 * "عدد الأخطاء المفتوحة" in the "الرئيسية" row for that project.
 * "القرار" is always logged as "بانتظار الرد" and "حالة التنفيذ" as
 * "لم يبدأ" — this only logs and proposes, it never fixes anything.
 *
 * Idempotent: لو كانت هناك حالة موجودة مسبقًا بنفس الوصف بالضبط في نفس
 * ورقة المشروع، لا تُضاف حالة مكررة — تُرجع رقم الحالة الموجودة فعليًا.
 *
 * @param {string} اسم_المشروع
 * @param {{نوع_الحالة:string, شدة_الحالة:string, الوصف:string, الخطة_المقترحة:string}} بيانات
 * @return {string} رقم الحالة (الجديدة، أو الموجودة مسبقًا إن كانت مكررة)
 */
function إضافة_حالة(اسم_المشروع, بيانات) {
  const الملف = SpreadsheetApp.openById(معرف_الشيت);
  const ورقة = الحصول_على_ورقة_أو_إنشاؤها(الملف, اسم_المشروع);
  تنسيق_الجدول(ورقة, أعمدة_تفاصيل_المشروع);

  const رقم_موجود = البحث_عن_حالة_بنفس_الوصف_(ورقة, بيانات.الوصف);
  if (رقم_موجود) return رقم_موجود;

  const الآن = new Date();
  const رقم_الحالة = 'ح-' + Utilities.formatDate(الآن, 'Asia/Riyadh', 'yyyyMMdd-HHmmss');

  const صف = {
    'رقم الحالة': رقم_الحالة,
    'تاريخ ووقت الاكتشاف': الآن,
    'نوع الحالة': بيانات.نوع_الحالة,
    'شدة الحالة': بيانات.شدة_الحالة,
    'الوصف': بيانات.الوصف,
    'الخطة المقترحة': بيانات.الخطة_المقترحة,
    'القرار': 'بانتظار الرد',
    'ملاحظات تعديلي': '',
    'حالة التنفيذ': 'لم يبدأ',
    'تاريخ آخر تحديث': الآن
  };

  const صف_جديد = ورقة.getLastRow() + 1;
  أعمدة_تفاصيل_المشروع.forEach(function (عمود, i) {
    ورقة.getRange(صف_جديد, i + 1).setValue(صف[عمود]);
  });

  تلوين_شدة_الحالة_شرطيًا(ورقة, أعمدة_تفاصيل_المشروع.indexOf('شدة الحالة') + 1);
  تحديث_عدد_الأخطاء_المفتوحة_(اسم_المشروع);

  return رقم_الحالة;
}

/**
 * يبحث في ورقة تفاصيل مشروع عن حالة موجودة بنفس نص "الوصف" بالضبط —
 * يمنع `إضافة_حالة` من تكرار نفس الحالة لو استُدعيت أكثر من مرة.
 *
 * @param {Sheet} ورقة
 * @param {string} الوصف
 * @return {string|null} رقم الحالة الموجودة، أو null إن لم توجد
 */
function البحث_عن_حالة_بنفس_الوصف_(ورقة, الوصف) {
  const آخر_صف = ورقة.getLastRow();
  if (آخر_صف < 2) return null;

  const رقم_عمود_رقم_الحالة = أعمدة_تفاصيل_المشروع.indexOf('رقم الحالة') + 1;
  const رقم_عمود_الوصف = أعمدة_تفاصيل_المشروع.indexOf('الوصف') + 1;
  const القيم = ورقة.getRange(2, 1, آخر_صف - 1, أعمدة_تفاصيل_المشروع.length).getValues();

  for (let i = 0; i < القيم.length; i++) {
    if (القيم[i][رقم_عمود_الوصف - 1] === الوصف) {
      return القيم[i][رقم_عمود_رقم_الحالة - 1];
    }
  }
  return null;
}

/**
 * يعيد حساب "عدد الأخطاء المفتوحة" لمشروع معيّن في جدول "الرئيسية"
 * (عدد الحالات التي حالة تنفيذها ليست "متم بالكامل") ويحدّثه.
 *
 * Recomputes "عدد الأخطاء المفتوحة" for a project in the "الرئيسية"
 * sheet (count of cases whose execution status isn't "متم بالكامل").
 *
 * @param {string} اسم_المشروع
 */
function تحديث_عدد_الأخطاء_المفتوحة_(اسم_المشروع) {
  const الملف = SpreadsheetApp.openById(معرف_الشيت);
  const ورقة_التفاصيل = الملف.getSheetByName(اسم_المشروع);
  const ورقة_الرئيسية = الملف.getSheetByName(اسم_ورقة_الرئيسية);
  if (!ورقة_التفاصيل || !ورقة_الرئيسية) return;

  const صف_المشروع = البحث_عن_صف_المشروع(ورقة_الرئيسية, اسم_المشروع);
  if (!صف_المشروع) return;

  const رقم_عمود_حالة_التنفيذ = أعمدة_تفاصيل_المشروع.indexOf('حالة التنفيذ') + 1;
  const آخر_صف = ورقة_التفاصيل.getLastRow();
  let عدد_مفتوحة = 0;
  if (آخر_صف >= 2) {
    const القيم = ورقة_التفاصيل.getRange(2, رقم_عمود_حالة_التنفيذ, آخر_صف - 1, 1).getValues();
    عدد_مفتوحة = القيم.filter(function (صف) { return صف[0] !== 'متم بالكامل' && صف[0] !== ''; }).length;
  }

  const رقم_عمود_عدد_الأخطاء = أعمدة_الرئيسية.indexOf('عدد الأخطاء المفتوحة') + 1;
  ورقة_الرئيسية.getRange(صف_المشروع, رقم_عمود_عدد_الأخطاء).setValue(عدد_مفتوحة);

  إعادة_حساب_نسبة_السلامة_(اسم_المشروع, ورقة_الرئيسية, صف_المشروع, عدد_مفتوحة);

  // إبطال كاش اللوحة فورًا — بدون هذا، اللوحة تستمر تعرض بيانات قديمة
  // حتى تنتهي صلاحية الكاش (300 ثانية) رغم أن الجدول تحدَّث فعليًا
  إبطال_كاش_اللوحة_();
}

/**
 * يُعيد حساب "نسبة السلامة" و"الحالة العامة" فورًا بعد أي تحديث لحالة
 * حالة واحدة — دون انتظار الفحص الدوري القادم (قد يصل حتى 12 ساعة).
 * بدون هذه الدالة، إغلاق حالة يُحدّث "عدد الأخطاء المفتوحة" فقط بينما
 * تبقى النسبة/الحالة معروضتين بقيمة قديمة حتى الفحص التالي — وهذا ما
 * كان يسبب تناقض "60% تحذير" رغم أن كل الحالات "متم بالكامل" فعليًا.
 *
 * لا تُغيّر شيئًا لو كانت "الحالة العامة" الحالية "متوقف" — تلك ناتجة
 * عن فشل فني حقيقي في آخر فحص (وليس عن حالات مسجَّلة)، ولا يصح
 * افتراض أن المشروع عاد للعمل لمجرد إغلاق حالة في السجل.
 *
 * @param {string} اسم_المشروع
 * @param {Sheet} ورقة_الرئيسية
 * @param {number} صف_المشروع
 * @param {number} عدد_مفتوحة
 */
function إعادة_حساب_نسبة_السلامة_(اسم_المشروع, ورقة_الرئيسية, صف_المشروع, عدد_مفتوحة) {
  const رقم_عمود_الحالة = أعمدة_الرئيسية.indexOf('الحالة العامة') + 1;
  const الحالة_الحالية = ورقة_الرئيسية.getRange(صف_المشروع, رقم_عمود_الحالة).getValue();
  if (الحالة_الحالية === 'متوقف') return;

  const رقم_عمود_النسبة = أعمدة_الرئيسية.indexOf('نسبة السلامة') + 1;
  const نسبة = Math.max(0, 1 - حساب_إجمالي_خصم_الحالات_المفتوحة_(اسم_المشروع));
  const حالة_جديدة = عدد_مفتوحة > 0 ? 'تحذير' : 'سليم';

  ورقة_الرئيسية.getRange(صف_المشروع, رقم_عمود_الحالة).setValue(حالة_جديدة);
  ورقة_الرئيسية.getRange(صف_المشروع, رقم_عمود_النسبة).setValue(نسبة).setNumberFormat('0%');
}

/**
 * يحدّث "القرار" و"حالة التنفيذ" لحالة واحدة محدَّدة برقمها — يُستخدم
 * لتسجيل ما تم إنجازه فعليًا خارج اللوحة (تنفيذ يدوي مباشر في كود
 * مشروع آخر)، تمييزًا عن تحديث_قرار_حالة_ في WebApi.gs التي تُحدّث
 * "القرار" فقط استجابة لضغطة زر من اللوحة.
 *
 * @param {string} اسم_المشروع
 * @param {string} رقم_الحالة
 * @param {string} القرار
 * @param {string} حالة_التنفيذ
 * @param {string} [ملاحظة]
 */
function تحديث_حالة_كاملة_(اسم_المشروع, رقم_الحالة, القرار, حالة_التنفيذ, ملاحظة) {
  const الملف = SpreadsheetApp.openById(معرف_الشيت);
  const ورقة = الملف.getSheetByName(اسم_المشروع);
  if (!ورقة) return;

  const رقم_عمود_رقم_الحالة = أعمدة_تفاصيل_المشروع.indexOf('رقم الحالة') + 1;
  const رقم_عمود_القرار = أعمدة_تفاصيل_المشروع.indexOf('القرار') + 1;
  const رقم_عمود_حالة_التنفيذ = أعمدة_تفاصيل_المشروع.indexOf('حالة التنفيذ') + 1;
  const رقم_عمود_ملاحظات = أعمدة_تفاصيل_المشروع.indexOf('ملاحظات تعديلي') + 1;
  const رقم_عمود_آخر_تحديث = أعمدة_تفاصيل_المشروع.indexOf('تاريخ آخر تحديث') + 1;

  const آخر_صف = ورقة.getLastRow();
  const أرقام = ورقة.getRange(2, رقم_عمود_رقم_الحالة, آخر_صف - 1, 1).getValues();
  for (let i = 0; i < أرقام.length; i++) {
    if (أرقام[i][0] === رقم_الحالة) {
      const صف = i + 2;
      ورقة.getRange(صف, رقم_عمود_القرار).setValue(القرار);
      ورقة.getRange(صف, رقم_عمود_حالة_التنفيذ).setValue(حالة_التنفيذ);
      if (ملاحظة) ورقة.getRange(صف, رقم_عمود_ملاحظات).setValue(ملاحظة);
      ورقة.getRange(صف, رقم_عمود_آخر_تحديث).setValue(new Date());
      break;
    }
  }
  تحديث_عدد_الأخطاء_المفتوحة_(اسم_المشروع);
}

/**
 * تسجيل لمرة واحدة: يحدّث حالة "بيانات المحطات بدون تسجيل دخول" —
 * حُلَّت بالكامل (تحقق هوية إجباري على 4 دوال بيانات محطات).
 */
function تحديث_حالة_بيانات_المحطات_بعد_الإصلاح() {
  تحديث_حالة_كاملة_(
    'احداثيات المحطات', 'ح-20260824-203213', 'موافقة', 'متم بالكامل',
    'أُضيف تحقق إجباري من هوية عضو نشط قبل تنفيذ: عرض قائمة المحطات، البحث، الإحصائيات، والمحطات القريبة. صفحتا الدخول/المراسلة وتقويم الورديات لم تتأثرا (لا تستخدمان هذه الدوال).'
  );
}

/**
 * تسجيل لمرة واحدة: تحديث إضافي لحالة "لا تذكرة دخول موقّعة" — أُضيفت
 * تذكرة موقّعة (HMAC) فعلية تحمي الملف الشخصي (عرض وتعديل)، بالإضافة
 * لصلاحية المدير المحمية مسبقًا. لا تزال جزئية — بقية الوظائف الحساسة
 * (كلوحة المدير) لم تُنقَل بعد لنفس نظام التذكرة.
 */
function تحديث_حالة_تذكرة_الدخول_بعد_الملف_الشخصي() {
  تحديث_حالة_كاملة_(
    'احداثيات المحطات', 'ح-20260824-224754', 'موافقة', 'جاري التنفيذ جزئيًا',
    'مرحلة إضافية: أُضيفت تذكرة دخول موقّعة (HMAC) تُصدَر عند أي تسجيل دخول أو تسجيل ناجح، وتحمي الآن عرض وتعديل الملف الشخصي (تعذّر انتحال هوية عضو آخر لعرض/تعديل بياناته بمعرفة رقمه فقط). لوحة المدير وبقية الوظائف الحساسة لم تُنقَل بعد لنفس نظام التذكرة — مؤجَّلة لمرحلة لاحقة أوسع.'
  );
}

/**
 * تسجيل لمرة واحدة: إغلاق حالة "لا تذكرة دخول موقّعة" — أُضيفت الحماية
 * الأخيرة (لوحة المدير + حذف محطة)، وتغطية النطاق المتفق عليه اكتملت.
 */
function إغلاق_حالة_تذكرة_الدخول() {
  تحديث_حالة_كاملة_(
    'احداثيات المحطات', 'ح-20260824-224754', 'موافقة', 'متم بالكامل',
    'اكتمل النطاق المتفق عليه: تذكرة دخول موقّعة (HMAC) تحمي الآن صلاحية المدير، الملف الشخصي (عرض وتعديل)، ولوحة العمليات وحذف المحطة. الإضافة والتعديل (updateCoordinates, addNewStation) تُركا مفتوحين لأي عضو نشط بقرار صريح — النظام مصمم ليسمح للجميع بالمساهمة بحرية، وهذا ليس ثغرة بل تصميم مقصود.'
  );
}

/**
 * تسجيل لمرة واحدة: حالة أمنية جوهرية مكتشفة في "سهم" أثناء مراجعة عميقة —
 * غياب كامل لأي تحقق من صلاحية "مدير" على مستوى الخادم عبر كل نقاط الـ API
 * الإدارية والمالية. حقل isAdmin القادم من تسجيل الدخول يُستخدم فقط لتزيين
 * الواجهة الأمامية (إظهار/إخفاء لوحة المدير)، ولا يُتحقق منه إطلاقًا على
 * الخادم. الأخطر: updateSettings يسمح بتغيير adminPhone بلا أي حماية —
 * أي زائر يرسل رقم جواله في هذا الحقل يصبح "المدير" فعليًا فورًا، لأن كل
 * تحقق الإدارة بالنظام (isAdminPhone_) مجرد مقارنة phone === adminPhone.
 * تُشغَّل يدويًا مرة واحدة من محرر Apps Script. آمنة لإعادة التشغيل.
 */
function تسجيل_حالة_غياب_التفويض_في_سهم() {
  إضافة_حالة('سهم', {
    نوع_الحالة: 'خطأ صامت',
    شدة_الحالة: 'حرجة جدًا',
    الوصف: 'لا يوجد أي تحقق من صلاحية "مدير" على مستوى الخادم عبر كامل واجهة البرمجة (API) — تحقّقت من ذلك بمراجعة كل الدوال الحساسة (Members.gs, Settings.gs, Subscriptions.gs, Collection.gs, Associations.gs, MonthClosing.gs, Archive.gs) ولم أجد استثناءً واحدًا. حقل isAdmin القادم من تسجيل الدخول (loginByPhone/completeDeviceLogin وغيرها) يُستخدم فقط لتزيين الواجهة الأمامية (إظهار/إخفاء لوحة المدير)، ولا يتحقق منه الخادم إطلاقًا عند تنفيذ أي عملية. الأخطر: updateSettings تسمح بتغيير adminPhone بلا أي حماية — أي زائر يعرف رابط الـ API فقط (لا يحتاج حتى تسجيل دخول) يستطيع إرسال رقم جواله كـ adminPhone فيصبح "المدير" فعليًا فورًا، لأن isAdminPhone_ (في Settings.gs) هي المصدر الوحيد للتحقق من صلاحية الإدارة بالنظام بأكمله، وهي مجرد مقارنة phone === settings.adminPhone. بالإضافة لذلك، بدون أي حماية أيضًا: addMember/updateMember (تغيير جوال عضو موجود = استيلاء كامل على حسابه وبياناته المالية)/setMemberStatus، addAssociation/addSubscription/updateSubscription/withdrawSubscription (عمليات مالية)، confirmCollection (تسجيل دفع اشتراك شهري)، reopenMonth، restoreArchivedAssociation_ وغيرها — أي زائر يستطيع تنفيذ أي منها مباشرة دون تسجيل دخول.',
    الخطة_المقترحة: 'إضافة تحقق تفويض حقيقي على مستوى الخادم قبل كل إجراء إداري/مالي، بنفس نهج تذكرة الدخول الموقّعة (HMAC) المستخدم في مشروع احداثيات المحطات: تُصدر تذكرة موقّعة عند تسجيل الدخول تتضمن isAdmin كحقل موقّع (لا يمكن تزويره)، وتُضاف دالة requireAdmin_(token) تتحقق من التوقيع وisAdmin=true قبل تنفيذ أي من: updateSettings (وتحديدًا حماية أشد لتغيير adminPhone تحديدًا — ربما تتطلب تأكيدًا إضافيًا كإدخال رقم المدير الحالي)، addMember/updateMember/setMemberStatus، addAssociation وكل عمليات الاشتراكات، confirmCollection/confirmDelivery، reopenMonth، عمليات الأرشفة/الاستعادة. دوال القراءة العامة (getMembers, getAssociations, ...) تحتاج نقاشًا منفصلًا حول ما إذا كانت تتطلب "عضو نشط" على الأقل، بنفس فلسفة القرار السابق في احداثيات المحطات.'
  });
}

/**
 * تسجيل لمرة واحدة: يغلق حالة غياب التفويض في "سهم" بعد تنفيذ الإصلاح
 * فعليًا (تذكرة هوية موقّعة HMAC تحمي الآن الإعدادات وإدارة الأعضاء).
 * يبحث عن رقم الحالة تلقائيًا بنص وصفها بدل الاعتماد على رقم ثابت.
 */
function إغلاق_حالة_غياب_التفويض_في_سهم() {
  const الملف = SpreadsheetApp.openById(معرف_الشيت);
  const ورقة = الملف.getSheetByName('سهم');
  const الوصف_الأصلي = 'لا يوجد أي تحقق من صلاحية "مدير" على مستوى الخادم عبر كامل واجهة البرمجة (API) — تحقّقت من ذلك بمراجعة كل الدوال الحساسة (Members.gs, Settings.gs, Subscriptions.gs, Collection.gs, Associations.gs, MonthClosing.gs, Archive.gs) ولم أجد استثناءً واحدًا. حقل isAdmin القادم من تسجيل الدخول (loginByPhone/completeDeviceLogin وغيرها) يُستخدم فقط لتزيين الواجهة الأمامية (إظهار/إخفاء لوحة المدير)، ولا يتحقق منه الخادم إطلاقًا عند تنفيذ أي عملية. الأخطر: updateSettings تسمح بتغيير adminPhone بلا أي حماية — أي زائر يعرف رابط الـ API فقط (لا يحتاج حتى تسجيل دخول) يستطيع إرسال رقم جواله كـ adminPhone فيصبح "المدير" فعليًا فورًا، لأن isAdminPhone_ (في Settings.gs) هي المصدر الوحيد للتحقق من صلاحية الإدارة بالنظام بأكمله، وهي مجرد مقارنة phone === settings.adminPhone. بالإضافة لذلك، بدون أي حماية أيضًا: addMember/updateMember (تغيير جوال عضو موجود = استيلاء كامل على حسابه وبياناته المالية)/setMemberStatus، addAssociation/addSubscription/updateSubscription/withdrawSubscription (عمليات مالية)، confirmCollection (تسجيل دفع اشتراك شهري)، reopenMonth، restoreArchivedAssociation_ وغيرها — أي زائر يستطيع تنفيذ أي منها مباشرة دون تسجيل دخول.';
  const رقم_الحالة = البحث_عن_حالة_بنفس_الوصف_(ورقة, الوصف_الأصلي);
  if (!رقم_الحالة) { Logger.log('لم يُعثر على الحالة — تأكد أن تسجيل_حالة_غياب_التفويض_في_سهم شُغِّلت أولًا'); return; }

  تحديث_حالة_كاملة_(
    'سهم', رقم_الحالة, 'موافقة', 'متم بالكامل',
    'أُضيفت تذكرة هوية موقّعة (HMAC، gas/Identity.gs) تُصدَر عند كل تسجيل دخول ناجح، وتحمي الآن: updateSettings (وخصوصًا تغيير adminPhone — لا يعود ممكنًا إلا بتذكرة مدير حالية فعليًا، عدا الإعداد الأول قبل تعيين أي مدير)، addMember، updateMember، setMemberStatus. اختُبر حيًا على الخادم المنشور فعليًا: توكن عضو عادي يُرفض، توكن مدير حقيقي ينجح. بقرار صريح من محمد: العمليات المالية (الاشتراكات، التحصيل، التسليم، الجمعيات) تُركت عمدًا بلا حماية — نفس فلسفة القرار السابق في احداثيات المحطات، خطر مقبول ومفهوم. قراءة البيانات العامة (getMembers/getAssociations/getOverviewBundle) لا تزال مفتوحة بلا تسجيل دخول — قيد النقاش، لم يُحسم بعد.'
  );
}

