/**
 * Level 5 — الذكاء التاريخي: يسجّل نتيجة كل تشغيل فحص (دوري أو عميق) في جدولي "سجل التشغيل"
 * و"سجل فحوص المشاريع" (Constants.gs/SheetSetup.gs)، ويحلّل الاتجاهات عبر التشغيلات السابقة
 * لينتج ملاحظات ذكية (تصعيد فشل متكرر، تعافٍ، ارتفاع/انخفاض زمن استجابة) — بلا تكرار نفس الملاحظة
 * طالما لم تتغيّر الحالة (Transition-based، وليس إعادة إرسال كل تشغيل طالما المشكلة مستمرة).
 *
 * لا جدول ثالث لـ"الحالة الحالية للتصعيد" عمدًا (قرار محمد الصريح) — تُستنتَج من التاريخ مباشرة في
 * كل تشغيل؛ الحجم الحالي (عدة عشرات صف/يوم) صغير جدًا ليستحق التعقيد الإضافي. يمكن إضافة جدول/كاش
 * حالة مختصر لاحقًا فقط لو أصبح عدد المشاريع/الفحوصات كبيرًا بما يؤثر على الأداء فعليًا.
 */

const مفتاح_الملاحظات_العميقة_المعلّقة_ = 'ملاحظات_عميقة_معلّقة';

/** معرف تشغيل فريد بنفس نمط ترقيم الحالات القائم (رقم الحالة = 'ح-' + تاريخ ووقت) */
function توليد_معرف_تشغيل_() {
  return 'ت-' + Utilities.formatDate(new Date(), 'Asia/Riyadh', 'yyyyMMdd-HHmmss');
}

/**
 * يقرأ "سجل فحوص المشاريع" كاملاً (يجب استدعاؤها *قبل* تسجيل نتائج التشغيل الحالي، وإلا ستشمل
 * القراءة صفوف هذا التشغيل نفسه فتُفسِد منطق "المقارنة بالتشغيل السابق")، ويُجمِّعها حسب المفتاح
 * (المشروع + معرف الفحص + نوع التشغيل) — المطابقة تشمل نوع التشغيل صراحةً حتى لا يُقارَن فحص دوري
 * بنظيره العميق بالخطأ (قد يحملان نفس معرف الفحص، مثل STATIONS.LOGIN، بملفَي أداء مختلفين تمامًا).
 * @return {Object<string, Array<{الحالة:string, زمن_ms:number}>>} كل قائمة مرتَّبة زمنيًا تصاعديًا
 */
function قراءة_سجل_فحوص_مجمَّع_() {
  const الملف = SpreadsheetApp.openById(معرف_الشيت);
  const ورقة = الملف.getSheetByName(اسم_ورقة_سجل_فحوص_المشاريع);
  const خرائط = {};
  if (!ورقة || ورقة.getLastRow() < 2) return خرائط;

  const بيانات = ورقة.getRange(2, 1, ورقة.getLastRow() - 1, أعمدة_سجل_فحوص_المشاريع.length).getValues();
  بيانات.forEach(function (صف) {
    if (!صف[0]) return; // معرف تشغيل فارغ = صف فارغ بأسفل الجدول (نطاق التنسيق المسبق)
    const المشروع = صف[1], معرف_الفحص = صف[2], نوع_التشغيل = صف[3];
    const مفتاح = المشروع + '|' + معرف_الفحص + '|' + نوع_التشغيل;
    (خرائط[مفتاح] = خرائط[مفتاح] || []).push({ الحالة: صف[5], زمن_ms: Number(صف[6]) || 0 });
  });
  return خرائط;
}

/** متوسط آخر 5 قياسات ناجحة سابقة بالضبط — null إن كانت أقل من 5 متاحة (لا يبدأ فحص الاتجاه قبلها) */
function حساب_خط_الأساس_(أزمنة_ناجحة_سابقة) {
  if (أزمنة_ناجحة_سابقة.length < 5) return null;
  const آخر_خمسة = أزمنة_ناجحة_سابقة.slice(-5);
  return آخر_خمسة.reduce(function (s, ز) { return s + ز; }, 0) / 5;
}

/**
 * محرّك التصعيد — يقارن كل فحص فرعي بهذا التشغيل بتاريخه المباشر (سجل_مجمَّع، من
 * قراءة_سجل_فحوص_مجمَّع_ *قبل* هذا التشغيل) وينتج ملاحظات عند **الانتقال** بين الحالات فقط:
 *
 * 1) REPEATED_FAILURE — فشل هذا الفحص الآن، وهذه هي المرة الثانية على التوالي بالضبط (وليس الثالثة
 *    فأكثر — التصعيد مرة واحدة فقط عند الدخول للمشكلة، لا تكرار طالما الفشل مستمرًا).
 * 2) RECOVERY — نجح الآن، وكان قد فشل بالتشغيل السابق مباشرة لنفس المفتاح.
 * 3) LATENCY_DEGRADATION / LATENCY_RECOVERY — فقط للفحوصات الناجحة، وفقط بعد توفّر 5 قياسات ناجحة
 *    سابقة فعلية (لا تشمل القياس الحالي). "تدهور" = الزمن الحالي ≥ ضعف متوسط الخط الأساسي، ويُبلَّغ
 *    مرة واحدة فقط عند الدخول لحالة التدهور (وليس في كل تشغيل يبقى فيه مرتفعًا)، ثم "تعافٍ" مرة
 *    واحدة عند العودة لما دون الضعف.
 *
 * @param {Array} نتائج نتائج فحص_<مشروع>_() لهذا التشغيل (سليم/فحوصات[]/اسم_المشروع)
 * @param {string} نوع_الفحص 'دوري' أو 'عميق' — جزء من مفتاح المطابقة
 * @param {Object} سجل_مجمَّع من قراءة_سجل_فحوص_مجمَّع_()
 * @return {Array<{نوع_الملاحظة:string, شدة:string, النص:string}>}
 */
function تحليل_الاتجاهات_(نتائج, نوع_الفحص, سجل_مجمَّع) {
  const ملاحظات = [];

  نتائج.forEach(function (نتيجة) {
    (نتيجة.فحوصات || []).forEach(function (ف) {
      const مفتاح = نتيجة.اسم_المشروع + '|' + ف.معرف + '|' + نوع_الفحص;
      const تاريخ = سجل_مجمَّع[مفتاح] || [];

      if (ف.الحالة === 'FAIL') {
        // عدّاد الفشل المتتالي including الحالي — يتوقف عند أول PASS بالتاريخ (رجوعًا من الأحدث)
        let متتالي = 1;
        for (let i = تاريخ.length - 1; i >= 0; i--) {
          if (تاريخ[i].الحالة === 'FAIL') متتالي++; else break;
        }
        if (متتالي === 2) {
          ملاحظات.push({
            نوع_الملاحظة: 'REPEATED_FAILURE',
            شدة: ف.أساسي ? '🔴' : '🟠',
            النص: نتيجة.اسم_المشروع + ': فشل ' + ف.اسم + ' مرتين متتاليتين' + (ف.أساسي ? '' : ' (فحص ثانوي)')
          });
        }
        return; // لا فحص اتجاه زمن على فحص فاشل — زمن الفشل ليس مؤشر أداء حقيقي للخدمة
      }

      // نجح الآن — تعافٍ إن كان آخر سجل لنفس المفتاح فاشلاً
      const آخر = تاريخ[تاريخ.length - 1];
      if (آخر && آخر.الحالة === 'FAIL') {
        ملاحظات.push({
          نوع_الملاحظة: 'RECOVERY',
          شدة: '🟡',
          النص: نتيجة.اسم_المشروع + ': تعافى ' + ف.اسم + ' منذ الفحص السابق'
        });
      }

      // اتجاه الزمن — يحتاج 5 قياسات ناجحة سابقة فعلية على الأقل (لا تشمل القياس الحالي)
      const أزمنة_ناجحة = تاريخ.filter(function (س) { return س.الحالة === 'PASS'; }).map(function (س) { return س.زمن_ms; });
      const خط_أساس_حالي = حساب_خط_الأساس_(أزمنة_ناجحة);
      if (خط_أساس_حالي === null) return; // لا بيانات كافية بعد لهذا الفحص تحديدًا

      const متدهور_الآن = ف.زمن_ms >= خط_أساس_حالي * 2;

      // هل كان "متدهورًا" أيضًا عند آخر قياس ناجح سابق؟ (لمنع تكرار نفس تنبيه الاتجاه كل تشغيل)
      const آخر_زمن_ناجح = أزمنة_ناجحة[أزمنة_ناجحة.length - 1];
      const خط_أساس_سابق = حساب_خط_الأساس_(أزمنة_ناجحة.slice(0, -1));
      const متدهور_سابقًا = خط_أساس_سابق !== null && آخر_زمن_ناجح !== undefined && آخر_زمن_ناجح >= خط_أساس_سابق * 2;

      if (متدهور_الآن && !متدهور_سابقًا) {
        ملاحظات.push({
          نوع_الملاحظة: 'LATENCY_DEGRADATION',
          شدة: '⚠️',
          النص: نتيجة.اسم_المشروع + ': ارتفع زمن ' + ف.اسم + ' من ~' + تنسيق_زمن_(Math.round(خط_أساس_حالي)) + ' إلى ' + تنسيق_زمن_(ف.زمن_ms)
        });
      } else if (!متدهور_الآن && متدهور_سابقًا) {
        ملاحظات.push({
          نوع_الملاحظة: 'LATENCY_RECOVERY',
          شدة: '🟡',
          النص: نتيجة.اسم_المشروع + ': عاد زمن ' + ف.اسم + ' لطبيعته (' + تنسيق_زمن_(ف.زمن_ms) + ')'
        });
      }
    });
  });

  return ملاحظات;
}

/**
 * يسجّل نتيجة تشغيل كامل (دوري أو عميق) بجدولي "سجل التشغيل"/"سجل فحوص المشاريع" — يضمن وجود
 * الجدولين أولاً (إنشاء تلقائي إضافي، بنفس ضمانات SheetSetup.gs، حتى لو لم تُشغَّل
 * تهيئة_قاعدة_البيانات يدويًا بعد هذا التحديث).
 * @return {string} معرف التشغيل المُولَّد
 */
function تسجيل_تاريخ_التشغيل_(نوع_الفحص, وقت_البدء, وقت_الانتهاء, نتائج, تم_الإرسال) {
  إنشاء_ورقة_سجل_التشغيل();
  إنشاء_ورقة_سجل_فحوص_المشاريع();

  const معرف_التشغيل = توليد_معرف_تشغيل_();
  const عدد_المفحوصة = نتائج.filter(function (ن) { return ن.الحالة_النهائية !== null && ن.الحالة_النهائية !== undefined; }).length;
  const عدد_السليمة = نتائج.filter(function (ن) { return ن.الحالة_النهائية === 'سليم'; }).length;
  const عدد_الفاشلة = عدد_المفحوصة - عدد_السليمة;

  const الملف = SpreadsheetApp.openById(معرف_الشيت);
  const ورقة_تشغيل = الملف.getSheetByName(اسم_ورقة_سجل_التشغيل);
  ورقة_تشغيل.appendRow([
    معرف_التشغيل, نوع_الفحص, وقت_البدء, وقت_الانتهاء, وقت_الانتهاء.getTime() - وقت_البدء.getTime(),
    عدد_المفحوصة, عدد_السليمة, عدد_الفاشلة, تم_الإرسال ? 'نعم' : 'لا'
  ]);

  const صفوف_فحوص = [];
  نتائج.forEach(function (ن) {
    (ن.فحوصات || []).forEach(function (ف) {
      صفوف_فحوص.push([
        معرف_التشغيل, ن.اسم_المشروع, ف.معرف, نوع_الفحص, ف.أساسي ? 'أساسي' : 'ثانوي',
        ف.الحالة, ف.زمن_ms, ف.رمز_HTTP || '', ف.رمز_الخطأ || '', ف.رسالة_خطأ || ''
      ]);
    });
  });
  if (صفوف_فحوص.length) {
    const ورقة_فحوص = الملف.getSheetByName(اسم_ورقة_سجل_فحوص_المشاريع);
    ورقة_فحوص.getRange(ورقة_فحوص.getLastRow() + 1, 1, صفوف_فحوص.length, صفوف_فحوص[0].length).setValues(صفوف_فحوص);
  }

  return معرف_التشغيل;
}

/**
 * الفحص العميق صامت بالبريد (قرار سابق)، لكن تصعيداته لا يجب أن تُفقَد — تُحفَظ هنا (Script
 * Properties، بلا جدول ثالث) وتُستهلَك وتُمسَح في أول تقرير دوري لاحق (سحب_الملاحظات_العميقة_المعلّقة_)،
 * فيظهر مثل "🔴 احداثيات المحطات: getStats فشل في آخر فحصين عميقين" بالتقرير الدوري التالي بدل
 * فقدان الإشارة كليًا لمجرد أن مصدرها فحص صامت.
 */
function حفظ_ملاحظات_عميقة_معلّقة_(ملاحظات) {
  if (!ملاحظات.length) return;
  const props = PropertiesService.getScriptProperties();
  const موجودة = JSON.parse(props.getProperty(مفتاح_الملاحظات_العميقة_المعلّقة_) || '[]');
  props.setProperty(مفتاح_الملاحظات_العميقة_المعلّقة_, JSON.stringify(موجودة.concat(ملاحظات)));
}

/** يسحب كل الملاحظات العميقة المعلَّقة ويمسحها فورًا (تُستهلَك مرة واحدة فقط بالتقرير الدوري التالي) */
function سحب_الملاحظات_العميقة_المعلّقة_() {
  const props = PropertiesService.getScriptProperties();
  const موجودة = JSON.parse(props.getProperty(مفتاح_الملاحظات_العميقة_المعلّقة_) || '[]');
  props.deleteProperty(مفتاح_الملاحظات_العميقة_المعلّقة_);
  return موجودة;
}
